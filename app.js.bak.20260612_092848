    const pctStr = (p.unrealized_pnl_pct >= 0 ? '+' : '') + p.unrealized_pnl_pct.toFixed(1) + '%';
    posTable += `| ${p.ticker} | ${pnlStr} (${pctStr}) | ${(p.weight_pct || 0).toFixed(1)}% | $${(p.market_value || 0).toLocaleString('en-US', {maximumFractionDigits:0})} |\n`;
  });

  const totalPnl = pf.total_pnl ?? 0;
  const totalPnlPct = pf.total_pnl_pct ?? 0;
  const dailyPnl = pf.daily_pnl ?? 0;

