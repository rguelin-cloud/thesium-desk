const _originalFetch = window.fetch.bind(window);

// In-memory mock orders store (loaded once from MOCK_API_DATA)
let _mockOrders = null;
function _getMockOrders() {
  if (!_mockOrders && window.MOCK_API_DATA && window.MOCK_API_DATA['/api/orders']) {
    const src = window.MOCK_API_DATA['/api/orders'];
    _mockOrders = JSON.parse(JSON.stringify(src.orders ?? src ?? []));
  }
  return _mockOrders || [];
}
function _mockResp(data, status = 200) {
  return new Response(JSON.stringify(data), {status, headers: {'Content-Type': 'application/json'}});
}

// Helper: get current price for a ticker from dashboard positions
function _getTickerPrice(ticker) {
  try {
    const dashData = window.MOCK_API_DATA['/api/dashboard'];
    const positions = dashData?.positions ?? [];
    const pos = positions.find(p => p.ticker === ticker);
    if (pos && pos.current_price) return pos.current_price;
  } catch(e) { /* fall through */ }
  // Fallback prices for common tickers
  const fallback = {AAPL:259.66,MSFT:405.20,GOOGL:299.68,AMZN:216.82,NVDA:181.59,TSLA:405.94,META:667.73,JPM:299.02,SPY:680.33,BTC:87206,ETH:2100};
  return fallback[ticker] || 150 + Math.random() * 100;
}

// Helper: create a fill record and prepend to mock fills data
function _addFillRecord(order, fillPrice) {
  const fillsData = window.MOCK_API_DATA['/api/fills'];
  if (!fillsData) return;
  const fills = fillsData.fills ?? [];
  const maxId = fills.length > 0 ? Math.max(...fills.map(f => f.id)) : 0;
  const slippage = +(Math.random() * 30 + 5).toFixed(2); // 5-35 bps
  const fees = +(order.quantity * 0.005).toFixed(2);       // $0.005/share
  const newFill = {
    id: maxId + 1,
    fill_price: fillPrice,
    fill_quantity: order.quantity,
    slippage: slippage,
    fees: fees,
    filled_at: new Date().toISOString(),
    side: (order.side ?? 'buy').toLowerCase(),
    order_type: order.order_type ?? 'market',
    ticker: order.ticker,
    name: order.name ?? order.ticker
  };
  fills.unshift(newFill); // prepend
  fillsData.fills = fills;
  fillsData.total = fills.length;
}

