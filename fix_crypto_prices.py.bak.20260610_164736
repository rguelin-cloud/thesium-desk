# Delete old fake prices
for ticker, inst_id in instruments.items():
    deleted = conn.execute("DELETE FROM prices WHERE instrument_id = ?", (inst_id,)).rowcount
    print(f"Deleted {deleted} fake prices for {ticker}")

# Insert real prices with synthetic OHLCV
for ticker, prices in REAL_PRICES.items():
    inst_id = instruments.get(ticker)
    if not inst_id:
        print(f"WARNING: {ticker} not found in instruments")
        continue
    
    for date, close in prices:
        # Generate realistic OHLCV from close
        import random
        random.seed(hash(f"{ticker}{date}"))
        daily_range = close * 0.03  # ~3% daily range for crypto
        high = close + random.uniform(0, daily_range * 0.6)
        low = close - random.uniform(0, daily_range * 0.6)
        opn = close + random.uniform(-daily_range * 0.3, daily_range * 0.3)
        # Ensure open is between low and high
        opn = max(low, min(high, opn))
        vol = random.uniform(20e9, 60e9) if ticker == "BTC" else \
              random.uniform(8e9, 20e9) if ticker == "ETH" else \
              random.uniform(200e6, 800e6)
        
        conn.execute(
            """INSERT OR REPLACE INTO prices (instrument_id, date, open, high, low, close, volume)
               VALUES (?, ?, ?, ?, ?, ?, ?)""",
            (inst_id, date, round(opn, 2), round(high, 2), round(low, 2), close, round(vol, 2))
        )
    print(f"Inserted {len(prices)} real prices for {ticker}")

