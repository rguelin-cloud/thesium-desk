# Recalculate total portfolio value and weights
# Get all positions with latest prices
rows = conn.execute("""
    SELECT pp.id, pp.instrument_id, pp.quantity, pp.avg_cost,
           (SELECT p.close FROM prices p WHERE p.instrument_id = pp.instrument_id ORDER BY p.date DESC LIMIT 1) as latest_price
    FROM portfolio_positions pp
""").fetchall()

cash = conn.execute("SELECT cash FROM portfolio_state WHERE id=1").fetchone()[0]
total_market_value = sum(r["quantity"] * (r["latest_price"] or r["avg_cost"]) for r in rows if r["quantity"])
total_value = cash + total_market_value

print(f"\nPortfolio recalc:")
print(f"  Cash: ${cash:,.2f}")
print(f"  Market value: ${total_market_value:,.2f}")
print(f"  Total: ${total_value:,.2f}")

# Update weights for all positions
for r in rows:
    mv = r["quantity"] * (r["latest_price"] or 0)
    weight = (mv / total_value * 100) if total_value > 0 else 0
    current_p = r["latest_price"] or r["avg_cost"]
    pnl = r["quantity"] * (current_p - r["avg_cost"])
    conn.execute("""UPDATE portfolio_positions 
        SET current_price=?, weight_pct=?, unrealized_pnl=?
        WHERE id=?""",
        (current_p, round(weight, 3), round(pnl, 2), r["id"]))

# Update portfolio state
total_cost = sum(r["quantity"] * r["avg_cost"] for r in rows if r["quantity"])
total_pnl = total_market_value - total_cost
total_pnl_pct = (total_pnl / total_cost * 100) if total_cost else 0

conn.execute("""UPDATE portfolio_state 
    SET total_value=?, total_pnl=?, total_pnl_pct=?, updated_at=datetime('now')
    WHERE id=1""",
    (round(total_value, 2), round(total_pnl, 2), round(total_pnl_pct, 4)))

print(f"  Total P&L: ${total_pnl:,.2f} ({total_pnl_pct:+.2f}%)")

