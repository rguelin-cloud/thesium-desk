# [RISK_V2_WIRED] Pre-trade controls section
def _build_risk_v2_section(conn: sqlite3.Connection) -> str:
    """Render the pre-trade [RISK_V2] controls table for the current cycle's orders."""
    orders = conn.execute(
        """SELECT o.id, o.side, o.quantity, o.status, o.risk_check_result, i.ticker
           FROM orders o JOIN instruments i ON i.id = o.instrument_id
           ORDER BY o.created_at DESC LIMIT 10"""
    ).fetchall()
    if not orders:
        return ""

    rows_seen = 0
    body = []
    for o in orders:
        try:
            rc = json.loads(o["risk_check_result"]) if o["risk_check_result"] else {}
        except Exception:
            rc = {}
        v2 = rc.get("risk_v2")
        if not v2:
            continue
        rows_seen += 1
        d = v2.get("details", {})
        c = d.get("concentration", {}) or {}
        v = d.get("var", {}) or {}
        cor = d.get("correlation", {}) or {}

        blocked = v2.get("blocked_by")
        passed = v2.get("passed", True)
        verdict = "PASS" if passed else f"BLOCK ({blocked})"

        new_pct = c.get("new_pct")
        new_pct_str = f"{(new_pct*100):.2f}%" if isinstance(new_pct, (int, float)) else "n/a"

        var_dm = v.get("delta_marginal_pct")
        var_dm_str = f"{(var_dm*100):.3f}%" if isinstance(var_dm, (int, float)) else (v.get("note", "n/a"))

        cor_max = cor.get("max_correl_value")
        cor_sym = cor.get("max_correl_symbol", "")
        cor_str = (f"{cor_max:.2f} vs {cor_sym}" if isinstance(cor_max, (int, float))
                   else (cor.get("note", "n/a")))

        body.append(
            f"| #{o['id']} | {o['ticker']} | {o['side'].upper()} | "
            f"{int(o['quantity'])} | {verdict} | {new_pct_str} | {var_dm_str} | {cor_str} |"
        )

    if rows_seen == 0:
        return ""

    head = [
        "## Pre-trade Controls [RISK_V2]",
        "",
        "Controls: Concentration 15% per name (BLOCK), VaR historical 99%/1d budget+marginal (WARN), Pearson correlation 60d (WARN).",
        "",
        "| Order | Ticker | Side | Qty | Verdict | Concentration | Delta VaR | Max Correlation |",
        "|-------|--------|------|-----|---------|---------------|-----------|------------------|",
    ]
    return "\n".join(head + body) + "\n\n"


def generate_ic_memo(conn: sqlite3.Connection, agent_results: dict | None = None) -> int:
    """
    Build a complete IC memo from current state and store in DB.
    Returns the memo ID.
    """
    date_str = datetime.utcnow().strftime("%Y-%m-%d")
    title    = f"Nextones IC Memo – {date_str}"

    portfolio_state = conn.execute("SELECT * FROM portfolio_state WHERE id = 1").fetchone()
    ps = dict(portfolio_state) if portfolio_state else {}

    macro_result   = agent_results.get("macro", {})   if agent_results else {}
    factor_results = agent_results.get("factor", [])  if agent_results else []
    micro_results  = agent_results.get("microstructure", []) if agent_results else []
    alt_results    = agent_results.get("altdata", [])  if agent_results else []

    # Build full markdown
    sections = [
        _build_header(date_str, ps),
        _build_macro_section(macro_result),
        _build_factor_section(factor_results),
        _build_thesis_section(conn, agent_results or {}),
        _build_proposed_changes_section(conn),
        _build_risk_v2_section(conn),  # [RISK_V2_WIRED]
        _build_audit_trail_section(conn),
        "\n---\n*This memo was automatically generated by Nextones.finance. Not investment advice.*\n",
    ]
    full_markdown = "\n".join(sections)

    # Prepare JSON summaries
    macro_summary = macro_result.get("stance", "neutral") if macro_result else "not available"
    factor_tilts  = {
        "overweight":  [f["ticker"] for f in factor_results if f.get("tilt") == "overweight"],
        "underweight": [f["ticker"] for f in factor_results if f.get("tilt") == "underweight"],
    }

    thesis_summaries = [
        {
            "ticker":    t.get("ticker"),
            "agent":     t.get("agent_type") if hasattr(t, "get") else "",
            "conviction": t.get("conviction", t.get("conviction_score", 0)) if hasattr(t, "get") else 0,
            "action":    t.get("proposed_action"),
        }
        for t in (
            list(factor_results[:5]) +
            [{"ticker": m.get("ticker"), "agent_type": "MicrostructureAgent",
              "conviction": m.get("conviction"), "proposed_action": m.get("proposed_action")}
             for m in micro_results[:5]]
        )
        if t
    ]

    proposed_changes_rows = conn.execute(
        """SELECT o.id, o.side, o.quantity, o.status, i.ticker
           FROM orders o JOIN instruments i ON i.id = o.instrument_id
           ORDER BY o.created_at DESC LIMIT 10"""
    ).fetchall()
    proposed_changes = [
        {"order_id": r["id"], "ticker": r["ticker"], "side": r["side"],
         "quantity": r["quantity"], "status": r["status"]}
        for r in proposed_changes_rows
    ]

    cur = conn.execute(
        """INSERT INTO ic_memos
               (date, title, macro_summary, factor_tilts, thesis_summaries,
                proposed_changes, full_markdown)
           VALUES (?, ?, ?, ?, ?, ?, ?)""",
        (
            date_str, title, macro_summary,
            json.dumps(factor_tilts),
            json.dumps(thesis_summaries),
            json.dumps(proposed_changes),
            full_markdown,
        )
    )
    memo_id = cur.lastrowid

    log_event(conn, "ic_memo_generated", "ic_memo", memo_id,
              {"date": date_str, "title": title, "sections": len(sections)},
              agent="MemoGenerator")

    return memo_id


if __name__ == "__main__":
    from models import init_db
    init_db()
    conn = get_db()
    memo_id = generate_ic_memo(conn)
    conn.commit()
    print(f"Memo generated with ID {memo_id}")
    conn.close()
