"""
memo_generator.py - IC Memo generation for Nextones.finance
Generates Markdown Investment Committee memos from agent results and portfolio state.
"""
import json
import sqlite3
from datetime import datetime
from models import get_db, log_event


# ---------------------------------------------------------------------------
# Memo Sections
# ---------------------------------------------------------------------------

def _build_header(date_str: str, portfolio_state: dict) -> str:
    total_value = portfolio_state.get("total_value", 0)
    total_pnl   = portfolio_state.get("total_pnl", 0)
    total_pnl_pct = portfolio_state.get("total_pnl_pct", 0)
    var_95      = portfolio_state.get("var_95", 0)
    cash        = portfolio_state.get("cash", 0)

    return f"""# Nextones IC Memo – {date_str}
**Generated:** {datetime.utcnow().strftime("%Y-%m-%d %H:%M UTC")}
**Mode:** Paper Trading | **Disclaimer:** Not investment advice. Research and execution automation under user control.

---

## Portfolio Snapshot

| Metric | Value |
|--------|-------|
| Total AUM | ${total_value:,.2f} |
| Cash | ${cash:,.2f} ({cash / total_value * 100:.1f}% of AUM) |
| Total P&L | ${total_pnl:+,.2f} ({total_pnl_pct:+.2f}%) |
| VAR (95%, 1-day) | {var_95:.2f}% of AUM |

"""


def _build_macro_section(macro_result: dict) -> str:
    if not macro_result:
        return "## Macro Outlook\n\n*No macro data available.*\n\n"

    stance     = macro_result.get("stance", "neutral").upper()
    conviction = macro_result.get("conviction", 0)
    proposed   = macro_result.get("proposed_action", "")
    signals    = macro_result.get("signals", {})

    lines = [
        "## Macro Outlook",
        "",
        f"**Stance:** {stance} | **Conviction:** {conviction}/10",
        "",
        "### Market Indicators",
        "",
        "| Index ETF | Price | SMA50 | SMA200 | Cross | RSI(14) | 20d Momentum |",
        "|-----------|-------|-------|--------|-------|---------|--------------|",
    ]

    for ticker, sig in signals.items():
        lines.append(
            f"| {ticker} | ${sig.get('current_price', 0):.2f} | "
            f"${sig.get('sma50', 0) or 0:.2f} | "
            f"${sig.get('sma200', 0) or 0:.2f} | "
            f"{sig.get('cross', 'N/A')} | "
            f"{sig.get('rsi14', 0) or 0:.1f} | "
            f"{sig.get('momentum_20d', 0):+.1f}% |"
        )

    lines += [
        "",
        f"**Recommended posture:** {proposed}",
        "",
    ]
    return "\n".join(lines) + "\n"


def _build_factor_section(factor_results: list) -> str:
    if not factor_results:
        return "## Factor Tilts\n\n*No factor data available.*\n\n"

    overweight  = [f for f in factor_results if f.get("tilt") == "overweight"]
    underweight = [f for f in factor_results if f.get("tilt") == "underweight"]
    neutral     = [f for f in factor_results if f.get("tilt") == "neutral"]

    lines = [
        "## Factor Tilts",
        "",
        f"**Overweight:** {', '.join(f['ticker'] for f in overweight) or 'None'}",
        f"**Underweight:** {', '.join(f['ticker'] for f in underweight) or 'None'}",
        f"**Neutral:** {', '.join(f['ticker'] for f in neutral) or 'None'}",
        "",
        "### Factor Scores",
        "",
        "| Ticker | Composite Score | Tilt | Conviction | Proposed Action |",
        "|--------|----------------|------|------------|----------------|",
    ]

    for f in factor_results[:10]:  # Top 10
        lines.append(
            f"| {f['ticker']} | {f.get('combined_score', 0):.2f}/10 | "
            f"**{f.get('tilt', 'neutral')}** | "
            f"{f.get('conviction', 0):.1f} | "
            f"{f.get('proposed_action', '')[:60]}... |"
        )

    lines.append("")
    return "\n".join(lines) + "\n"


def _build_thesis_section(conn: sqlite3.Connection, agent_results: dict) -> str:
    lines = [
        "## Active Thesis Summaries",
        "",
    ]

    # Get most recent theses per agent type
    theses = conn.execute(
        """SELECT t.id, t.agent_type, t.thesis_text, t.conviction_score, t.horizon,
                  t.proposed_action, i.ticker, i.name
           FROM theses t
           LEFT JOIN instruments i ON i.id = t.instrument_id
           WHERE t.status = 'active'
           ORDER BY t.conviction_score DESC, t.updated_at DESC
           LIMIT 20"""
    ).fetchall()

    if not theses:
        return "## Active Thesis Summaries\n\n*No active theses.*\n\n"

    for t in theses:
        ticker_str = f"**{t['ticker']}** – " if t['ticker'] else ""
        lines += [
            f"### {ticker_str}{t['agent_type']} | Conviction: {t['conviction_score']:.1f}/10 | Horizon: {t['horizon']}",
            "",
            f"*Thesis ID #{t['id']}*",
            "",
            f"{t['proposed_action']}",
            "",
            "---",
            "",
        ]

    return "\n".join(lines)


def _build_proposed_changes_section(conn: sqlite3.Connection) -> str:
    """Show orders created in this cycle."""
    orders = conn.execute(
        """SELECT o.id, o.side, o.quantity, o.status, o.risk_check_result,
                  i.ticker, i.name,
                  f.fill_price, f.slippage, f.fees
           FROM orders o
           JOIN instruments i ON i.id = o.instrument_id
           LEFT JOIN fills f ON f.order_id = o.id
           ORDER BY o.created_at DESC
           LIMIT 10"""
    ).fetchall()

    if not orders:
        return "## Proposed Changes & Executions\n\n*No orders in this cycle.*\n\n"

    lines = [
        "## Proposed Changes & Executions",
        "",
        "| Order ID | Ticker | Side | Qty | Status | Fill Price | Slippage | Risk Notes |",
        "|----------|--------|------|-----|--------|------------|----------|------------|",
    ]

    for o in orders:
        risk_check = {}
        try:
            risk_check = json.loads(o["risk_check_result"]) if o["risk_check_result"] else {}
        except Exception:
            pass

        risk_notes = risk_check.get("action", "N/A")
        fill_str = f"${o['fill_price']:.2f}" if o["fill_price"] else "–"
        slip_str = f"${o['slippage']:.2f}" if o["slippage"] else "–"

        lines.append(
            f"| #{o['id']} | {o['ticker']} | {o['side'].upper()} | "
            f"{int(o['quantity'])} | {o['status']} | "
            f"{fill_str} | {slip_str} | {risk_notes} |"
        )

    lines.append("")
    return "\n".join(lines) + "\n"


def _build_audit_trail_section(conn: sqlite3.Connection) -> str:
    events = conn.execute(
        """SELECT event_type, entity_type, entity_id, agent, created_at, details
           FROM event_log
           ORDER BY created_at DESC LIMIT 20"""
    ).fetchall()

    lines = [
        "## Audit Trail",
        "",
        "| Timestamp (UTC) | Event | Agent | Entity | Details |",
        "|----------------|-------|-------|--------|---------|",
    ]

    for e in events:
        details_str = ""
        try:
            d = json.loads(e["details"]) if e["details"] else {}
            # Show key=value for first 2 items
            details_str = "; ".join(f"{k}={v}" for k, v in list(d.items())[:2])
        except Exception:
            pass

        lines.append(
            f"| {e['created_at'][:19]} | {e['event_type']} | "
            f"{e['agent'] or '–'} | "
            f"{e['entity_type'] or '–'}#{e['entity_id'] or '–'} | "
            f"{details_str[:60]} |"
        )

    lines.append("")
    return "\n".join(lines) + "\n"


