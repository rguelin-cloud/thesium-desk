CREATE TABLE ic_memos (
            id               INTEGER PRIMARY KEY AUTOINCREMENT,
            date             TEXT NOT NULL,
            title            TEXT NOT NULL,
            macro_summary    TEXT,
            factor_tilts     TEXT DEFAULT '{}',
            thesis_summaries TEXT DEFAULT '[]',
            proposed_changes TEXT DEFAULT '[]',
            full_markdown    TEXT,
            created_at       TEXT DEFAULT (datetime('now'))
        )

