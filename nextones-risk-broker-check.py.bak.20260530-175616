# [NEXTONES-RISK-BROKER-CHECK-V1]
# 5e controle Agent Risque : broker_mapping_ok.
# Ordre d'execution : EN PREMIER (decision user 30/05/2026, option A1).
#
# API publique:
#   check_broker_mapping(proposal: dict) -> dict
#       proposal attendu : {
#           'thesium_ticker': 'CSCO',
#           'side': 'buy'|'sell',
#           'qty': 166,
#           'asset_class': 'equity_us'   # optionnel
#       }
#       retour: {
#           'ok': bool,
#           'reason': str|None,
#           'broker_symbol': str|None,
#           'volume_lots': float,
#           'rounding_gap_pct': float,
#           'diagnostics': {...}
#       }
#
#   make_risk_decorator(existing_pretrade_func)
#       -> nouvelle fonction qui execute broker_check AVANT le pretrade.
#       Si broker_check echoue, on bypass les 4 controles suivants et on
#       renvoie un rejet structure identique a risk_pretrade.
#
# Usage import:
#   import importlib.util
#   spec = importlib.util.spec_from_file_location('rbc', 'nextones-risk-broker-check.py')
#   m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
#   result = m.check_broker_mapping({'thesium_ticker': 'HYPE', 'side': 'buy', 'qty': 100})

import os
import sys
import json
import sqlite3
import importlib.util
from datetime import datetime, timezone
from typing import Optional, Dict, Any

DB_PATH = os.environ.get(
    "THESIUM_DB",
    r"C:\Users\RichardGUELIN\Prod\ThesiumDesk\thesium.db",
)

_TRANSLATOR_PATH = os.path.join(
    os.path.dirname(os.path.abspath(__file__)),
    "nextones-order-translator.py",
)

_T = None


def _translator():
    global _T
    if _T is None:
        spec = importlib.util.spec_from_file_location(
            "_nx_order_translator", _TRANSLATOR_PATH
        )
        if spec is None or spec.loader is None:
            raise ImportError("Impossible de charger " + _TRANSLATOR_PATH)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        _T = mod
    return _T


def _audit(con, action: str, proposal: dict, result: dict):
    try:
        ts = datetime.now(timezone.utc).isoformat(timespec="seconds")
        cur = con.cursor()
        cur.execute(
            "INSERT INTO broker_mapping_audit(ts, action, thesium_ticker, "
            "broker_symbol, payload_json, notes) VALUES(?, ?, ?, ?, ?, ?)",
            (
                ts,
                "risk_check_" + action,
                proposal.get("thesium_ticker"),
                result.get("broker_symbol"),
                json.dumps({"proposal": proposal, "result": result},
                           default=str)[:4000],
                result.get("reason") or "ok",
            ),
        )
        con.commit()
    except Exception as e:
        print("[WARN] risk_broker_check audit: " + str(e))


def check_broker_mapping(proposal: Dict[str, Any],
                         db_path: Optional[str] = None) -> Dict[str, Any]:
    """
    Verifie qu'un proposal Thesium est tradable chez ActivTrades.
    Renvoie ok=False avec raison structuree si refus, sinon ok=True
    avec broker_symbol + volume_lots calcule.
    """
    if not isinstance(proposal, dict):
        return {"ok": False, "reason": "invalid_proposal_type",
                "broker_symbol": None, "volume_lots": 0.0,
                "rounding_gap_pct": 0.0, "diagnostics": {}}

    tkr = proposal.get("thesium_ticker") or proposal.get("ticker")
    side = (proposal.get("side") or "").lower()
    qty = proposal.get("qty") or proposal.get("quantity")
    ac = proposal.get("asset_class")

    if not tkr:
        return {"ok": False, "reason": "missing_ticker",
                "broker_symbol": None, "volume_lots": 0.0,
                "rounding_gap_pct": 0.0, "diagnostics": {}}

    T = _translator()
    res = T.translate(tkr, qty, side, asset_class=ac)

    result = {
        "ok": bool(res.accepted),
        "reason": res.reason,
        "broker_symbol": res.broker_symbol,
        "volume_lots": res.volume_lots,
        "rounding_gap_pct": res.rounding_gap_pct,
        "diagnostics": res.diagnostics,
    }

    path = db_path or DB_PATH
    try:
        con = sqlite3.connect(path)
        _audit(con, "accept" if result["ok"] else "reject", proposal, result)
        con.close()
    except Exception as e:
        print("[WARN] check_broker_mapping audit: " + str(e))

    return result


# ----------------------------------------------------------------------
# Wrapper pour Risk pretrade (ordre A1: broker check en PREMIER)
# ----------------------------------------------------------------------

def make_risk_decorator(existing_pretrade_func):
    """
    Decore une fonction pretrade(proposal, *args, **kwargs).
    Comportement :
      1. broker_check(proposal)   -- 5e controle, execute EN PREMIER
      2. si ok=False : retourne immediatement un dict de rejet
         (forme alignee avec risk_pretrade v2)
      3. si ok=True  : appelle la fonction pretrade existante et lui
         passe broker_symbol + volume_lots dans proposal pour permettre
         aux 4 controles classiques de raisonner en lots si besoin.
    """
    def wrapper(proposal, *args, **kwargs):
        bc = check_broker_mapping(proposal)
        if not bc["ok"]:
            return {
                "accepted": False,
                "controls_passed": [],
                "controls_failed": ["broker_mapping_ok"],
                "first_failure": "broker_mapping_ok",
                "reason": bc["reason"],
                "broker_symbol": bc["broker_symbol"],
                "diagnostics": bc["diagnostics"],
                "rejected_by": "broker_mapping_ok",
            }
        # Enrichit le proposal avec les infos broker pour les controls suivants
        enriched = dict(proposal)
        enriched["broker_symbol"] = bc["broker_symbol"]
        enriched["broker_volume_lots"] = bc["volume_lots"]
        enriched["broker_diagnostics"] = bc["diagnostics"]

        result = existing_pretrade_func(enriched, *args, **kwargs)

        # Garantit broker_mapping_ok est marque comme passe dans la trace
        if isinstance(result, dict):
            passed = list(result.get("controls_passed", []))
            if "broker_mapping_ok" not in passed:
                passed.insert(0, "broker_mapping_ok")
            result["controls_passed"] = passed
            result.setdefault("broker_symbol", bc["broker_symbol"])
        return result

    return wrapper


# ----------------------------------------------------------------------
# CLI smoke
# ----------------------------------------------------------------------

def _main_cli():
    if len(sys.argv) < 4:
        print("Usage: risk-broker-check <ticker> <side buy|sell> <qty> [--asset X]")
        sys.exit(1)
    tkr = sys.argv[1]
    side = sys.argv[2]
    qty = float(sys.argv[3])
    ac = None
    if "--asset" in sys.argv:
        i = sys.argv.index("--asset")
        if i + 1 < len(sys.argv):
            ac = sys.argv[i + 1]
    proposal = {"thesium_ticker": tkr, "side": side, "qty": qty,
                "asset_class": ac}
    print(json.dumps(check_broker_mapping(proposal), indent=2, default=str))


if __name__ == "__main__":
    _main_cli()
