# [MOJIBAKE_FIX_V1_HELPER]
def _fix_mojibake(s):
    """Tente de reparer un double-encoding UTF-8/cp1252.
    Detecte la presence de patterns mojibake et applique le reverse roundtrip.
    Si la chaine ne contient pas de mojibake, retourne telle quelle.
    """
    if not isinstance(s, str) or not s:
        return s
    # Detection rapide : patterns connus de double-encoding
    moji_markers = ("\u00e2\u2030\u00a4", "\u00e2\u2020", "\u00c3\u00a9", "\u00c3\u00a8", "\u00c3\u00a0")
    if not any(m in s for m in moji_markers):
        return s
    try:
        fixed = s.encode("cp1252", errors="strict").decode("utf-8", errors="strict")
        return fixed
    except (UnicodeEncodeError, UnicodeDecodeError):
        return s


def _build_convergence_section(conn):
    """
    Section 'Convergence Engine' du memo IC.
    Lit convergence_snapshots pour le cycle le plus recent et produit un
    tableau markdown segmente : forced_exit / drift / strong / neutres.
    Lecture seule. Fail-safe : placeholder si table manquante ou cycle absent.
    """
    try:
        cur = conn.cursor()
        # cycle le plus recent
        cur.execute("SELECT cycle_id, created_at FROM convergence_snapshots ORDER BY rowid DESC LIMIT 1")
        row = cur.fetchone()
        if not row:
            return "## Convergence Engine\n\n*Aucun snapshot convergence disponible.*\n\n"
        cycle_id = row[0]
        created_at = row[1] if len(row) > 1 else ""

        cur.execute("""
            SELECT ticker, direction_consensus, n_aligned, n_present, convergence_pct,
                   sizing_multiplier, forced_exit, drift, is_crypto, buckets_json
            FROM convergence_snapshots
            WHERE cycle_id = ?
            ORDER BY ticker
        """, (cycle_id,))
        rows = [dict(zip(
            ["ticker","dir","n","ntotal","pct","sizing","fe","drift","crypto","buckets"], r
        )) for r in cur.fetchall()]

        if not rows:
            return f"## Convergence Engine\n\n*Aucun ticker dans le cycle {cycle_id}.*\n\n"

        # totaux
        n_total = len(rows)
        n_fe = sum(1 for r in rows if r["fe"])
        n_drift = sum(1 for r in rows if r["drift"] and not r["fe"])
        n_strong = sum(1 for r in rows
                       if not r["fe"] and not r["drift"]
                       and (r["sizing"] or 0) >= 1.0 and (r["n"] or 0) >= 3)
        n_neutral = n_total - n_fe - n_drift - n_strong

        def _bucket_driver(r, key):
            try:
                buckets = json.loads(r["buckets"] or "{}")
            except Exception:
                buckets = {}
            b = buckets.get(key) or {}
            return (b.get("direction"), _fix_mojibake(b.get("driver")), b.get("source"))

        def _row_l5_driver(r):
            _, driver, _ = _bucket_driver(r, "L5")
            return driver or "-"

        def _row_dominant_drivers(r):
            try:
                buckets = json.loads(r["buckets"] or "{}")
            except Exception:
                buckets = {}
            parts = []
            for k in ["L1","L2","L3","L4","L5"]:
                b = buckets.get(k) or {}
                if b.get("direction"):
                    parts.append(f"{k}:{b.get('direction')}")
            return " · ".join(parts) if parts else "-"

        def _esc_md(s):
            if s is None:
                return "-"
            return str(s).replace("|", "\\|").replace("\n", " ").strip()

        out = []
        out.append("## Convergence Engine")
        out.append("")
        out.append(f"**Cycle {cycle_id}** · {created_at} · {n_total} tickers · "
                   f"{n_fe} forced_exit · {n_drift} drift · {n_strong} strong · {n_neutral} neutres")
        out.append("")

        # Forced exit
        fe_rows = [r for r in rows if r["fe"]]
        if fe_rows:
            out.append("### Forced exit (sizing x0.0)")
            out.append("")
            out.append("| Ticker | Consensus | Aligné | Driver L5 (ExitAgent) |")
            out.append("|---|---|---|---|")
            for r in sorted(fe_rows, key=lambda x: (-(x["pct"] or 0), x["ticker"])):
                badge = " (crypto)" if r["crypto"] else ""
                out.append(f"| **{r['ticker']}**{badge} | {r['dir'] or '-'} | "
                           f"{r['n']}/{r['ntotal']} | {_esc_md(_row_l5_driver(r))[:120]} |")
            out.append("")

        # Drift
        dr_rows = [r for r in rows if r["drift"] and not r["fe"]]
        if dr_rows:
            out.append("### Drift (sizing x0.5)")
            out.append("")
            out.append("| Ticker | Consensus | Aligné | Driver L5 (ExitAgent) |")
            out.append("|---|---|---|---|")
            for r in sorted(dr_rows, key=lambda x: x["ticker"]):
                badge = " (crypto)" if r["crypto"] else ""
                out.append(f"| **{r['ticker']}**{badge} | {r['dir'] or '-'} | "
                           f"{r['n']}/{r['ntotal']} | {_esc_md(_row_l5_driver(r))[:120]} |")
            out.append("")

        # Strong
        st_rows = [r for r in rows
                   if not r["fe"] and not r["drift"]
                   and (r["sizing"] or 0) >= 1.0 and (r["n"] or 0) >= 3]
        if st_rows:
            out.append("### Strong consensus (sizing x1.0+, n_aligned ≥ 3)")
            out.append("")
            out.append("| Ticker | Consensus | Aligné | Buckets actifs |")
            out.append("|---|---|---|---|")
            for r in sorted(st_rows, key=lambda x: (-(x["pct"] or 0), x["ticker"])):
                badge = " (crypto)" if r["crypto"] else ""
                out.append(f"| **{r['ticker']}**{badge} | {r['dir'] or '-'} | "
                           f"{r['n']}/{r['ntotal']} | {_esc_md(_row_dominant_drivers(r))[:120]} |")
            out.append("")

        # Neutres (resume seulement)
        nu_rows = [r for r in rows
                   if not r["fe"] and not r["drift"]
                   and not ((r["sizing"] or 0) >= 1.0 and (r["n"] or 0) >= 3)]
        if nu_rows:
            tickers_str = ", ".join(sorted(r["ticker"] for r in nu_rows))
            out.append(f"### Neutres ({len(nu_rows)} tickers)")
            out.append("")
            out.append(f"{tickers_str}")
            out.append("")
            out.append(f"*Conviction faible (n_aligned < 3 ou sizing par defaut). "
                       f"Detail complet dans la carte Convergence Engine du dashboard Today.*")
            out.append("")

        return "\n".join(out) + "\n"

    except Exception as _e_cvg:
        return f"## Convergence Engine\n\n*Erreur lecture convergence_snapshots : {_e_cvg}*\n\n"


def generate_ic_memo(conn: sqlite3.Connection, agent_results: dict | None = None) -> int:
    """
    Build a complete IC memo from current state and store in DB.
    Returns the memo ID.
    """
    date_str = datetime.utcnow().strftime("%Y-%m-%d")
    title    = f"Nextones IC Memo – {date_str}"

    portfolio_state = conn.execute("SELECT * FROM portfolio_state WHERE id = 1").fetchone()
    ps = dict(portfolio_state) if portfolio_state else {}

    macro_result   = agent_results.get("macro", {})   if agent_results else {}
    factor_results = agent_results.get("factor", [])  if agent_results else []
    micro_results  = agent_results.get("microstructure", []) if agent_results else []
    alt_results    = agent_results.get("altdata", [])  if agent_results else []

    # Build full markdown
    sections = [
        _build_header(date_str, ps),
        _build_diff_section(conn),  # [ICMEMO_DIFF_V1]
        _build_macro_section(macro_result),
        _build_factor_section(factor_results),
        _build_thesis_section(conn, agent_results or {}),
        _build_proposed_changes_section(conn),
        _build_risk_v2_section(conn),  # [RISK_V2_WIRED]
        _build_market_regime_section(conn),  # [PATCH_MEMO_MARKET_REGIME_V1]
        _build_audit_trail_section(conn),
        "\n---\n*This memo was automatically generated by Nextones.finance. Not investment advice.*\n",
    ]
    sections.append(_build_convergence_section(conn))  # [ICMEMO_CONVERGENCE_V1]
    full_markdown = "\n".join(sections)

    # Prepare JSON summaries
    macro_summary = macro_result.get("stance", "neutral") if macro_result else "not available"
    factor_tilts  = {
        "overweight":  [f["ticker"] for f in factor_results if f.get("tilt") == "overweight"],
        "underweight": [f["ticker"] for f in factor_results if f.get("tilt") == "underweight"],
    }

    thesis_summaries = [
        {
            "ticker":    t.get("ticker"),
            "agent":     t.get("agent_type") if hasattr(t, "get") else "",
            "conviction": t.get("conviction", t.get("conviction_score", 0)) if hasattr(t, "get") else 0,
            "action":    t.get("proposed_action"),
        }
        for t in (
            list(factor_results[:5]) +
            [{"ticker": m.get("ticker"), "agent_type": "MicrostructureAgent",
              "conviction": m.get("conviction"), "proposed_action": m.get("proposed_action")}
             for m in micro_results[:5]]
        )
        if t
    ]

    # [PATCH_MEMO_ORDERS_BY_CYCLE_V1] filtre proposed_changes par cycle courant
    _cur_cycle_row = conn.execute(
        "SELECT cycle_id FROM regime_log ORDER BY id DESC LIMIT 1"
    ).fetchone()
    _cur_cycle_id = _cur_cycle_row[0] if _cur_cycle_row else None
    if _cur_cycle_id:
        proposed_changes_rows = conn.execute(
            """SELECT o.id, o.side, o.quantity, o.status, i.ticker
               FROM orders o JOIN instruments i ON i.id = o.instrument_id
               WHERE o.cycle_id = ?
               ORDER BY o.created_at DESC LIMIT 50""",
            (_cur_cycle_id,)
        ).fetchall()
    else:
        proposed_changes_rows = conn.execute(
            """SELECT o.id, o.side, o.quantity, o.status, i.ticker
               FROM orders o JOIN instruments i ON i.id = o.instrument_id
               ORDER BY o.created_at DESC LIMIT 10"""
        ).fetchall()
    proposed_changes = [
        {"order_id": r["id"], "ticker": r["ticker"], "side": r["side"],
         "quantity": r["quantity"], "status": r["status"]}
        for r in proposed_changes_rows
    ]

    cur = conn.execute(
        """INSERT INTO ic_memos
               (date, title, macro_summary, factor_tilts, thesis_summaries,
                proposed_changes, full_markdown)
           VALUES (?, ?, ?, ?, ?, ?, ?)""",
        (
            date_str, title, macro_summary,
            json.dumps(factor_tilts),
            json.dumps(thesis_summaries),
            json.dumps(proposed_changes),
            full_markdown,
        )
    )
    memo_id = cur.lastrowid

    log_event(conn, "ic_memo_generated", "ic_memo", memo_id,
              {"date": date_str, "title": title, "sections": len(sections)},
              agent="MemoGenerator")

    return memo_id




# [PATCH_MEMO_MARKET_REGIME_V1]  ----------------------------------------------------------------
def _build_market_regime_section(conn) -> str:
    """Section memo IC : regime de marche (equity vs crypto).

    Lit la derniere ligne de regime_log + 2 lignes de market_regime_log.
    Fallback gracieux si table absente ou pas de donnees.
    """
    try:
        import json as _json
        # Dernier cycle
        row = conn.execute(
            "SELECT cycle_id, regime, invested_pct, nav, equity_regime, "
            "crypto_regime, equity_buy_mult, equity_sell_mult, "
            "crypto_buy_mult, crypto_sell_mult, created_at "
            "FROM regime_log ORDER BY id DESC LIMIT 1"
        ).fetchone()
        if not row:
            return "## R\u00e9gime de March\u00e9\n\n*Aucun cycle disponible.*\n\n"
        # Detail equity / crypto depuis market_regime_log
        cid = row["cycle_id"] if hasattr(row, "keys") else row[0]
        market_rows = conn.execute(
            "SELECT asset_class, regime, vix_value, realized_vol_pct, "
            "drawdown_5d_pct, buy_mult, sell_mult, convergence_thresh, "
            "details_json FROM market_regime_log WHERE cycle_id = ? "
            "ORDER BY asset_class",
            (cid,)
        ).fetchall()
        # Helpers
        def _impact(asset_class, regime):
            if regime == "STRESS":
                if asset_class == "crypto":
                    return "DCA crypto autoris\u00e9 (BUY x1.8), SELL frein\u00e9s (x0.5)"
                return "Acheter la baisse equity (BUY x1.8), SELL frein\u00e9s (x0.5)"
            if regime == "CALM":
                if asset_class == "crypto":
                    return "Take profit crypto facilit\u00e9 (SELL x1.5), BUY prudents (x0.7)"
                return "Take profit equity facilit\u00e9 (SELL x1.5), BUY prudents (x0.7)"
            return "R\u00e9gime neutre - aucune amplification"
        out = ["## R\u00e9gime de March\u00e9 [MARKET_REGIME_V1]\n"]
        out.append(
            f"**Cycle :** {cid}  -  **Portfolio regime :** {row['regime']} "
            f"(invested={row['invested_pct']:.1f}%, NAV={row['nav']:,.0f} $)\n"
        )
        if not market_rows:
            out.append("\n*Aucune donn\u00e9e market_regime_log pour ce cycle.*\n\n")
            return "\n".join(out)
        out.append("")
        out.append("| Asset class | R\u00e9gime | VIX | Vol ann. | DD 5j | BUY mult | SELL mult | Impact pratique |")
        out.append("|---|---|---|---|---|---|---|---|")
        for r in market_rows:
            ac = r["asset_class"]
            rg = r["regime"]
            vix = r["vix_value"]
            vol = r["realized_vol_pct"]
            dd = r["drawdown_5d_pct"]
            bm = r["buy_mult"]
            sm = r["sell_mult"]
            vix_str = f"{vix:.2f}" if vix is not None else "-"
            vol_str = f"{vol:.1f}%" if vol is not None else "-"
            dd_str = f"{dd:.2f}%" if dd is not None else "-"
            bm_str = f"x{bm:.2f}" if bm is not None else "-"
            sm_str = f"x{sm:.2f}" if sm is not None else "-"
            impact = _impact(ac, rg)
            out.append(
                f"| {ac} | **{rg}** | {vix_str} | {vol_str} | {dd_str} | "
                f"{bm_str} | {sm_str} | {impact} |"
            )
        # Detail des signaux (JSON dans details_json)
        out.append("")
        out.append("### D\u00e9tail des signaux\n")
        for r in market_rows:
            ac = r["asset_class"]
            try:
                det = _json.loads(r["details_json"] or "{}")
            except Exception:
                det = {}
            calm_n = det.get("signals_calm", "-")
            stress_n = det.get("signals_stress", "-")
            sub = []
            for k in ("vix_signal", "vol_signal", "dd_signal"):
                if k in det:
                    sub.append(f"{k.replace('_signal','')}={det[k]}")
            sub_str = ", ".join(sub) if sub else "-"
            out.append(
                f"- **{ac}** : {sub_str} -> {calm_n} CALM, {stress_n} STRESS "
                f"-> classification **{r['regime']}**"
            )
        out.append("")
        # Note methodologique courte
        out.append(
            "_Equity : majorit\u00e9 simple sur 3 signaux (VIX, vol 20j, drawdown 5j). "
            "Crypto : 1 seul signal STRESS suffit (plus r\u00e9actif). "
            "Multiplicateurs : CALM 0.7/1.5, NORMAL 1.0/1.0, STRESS 1.8/0.5._"
        )
        return "\n".join(out) + "\n\n"
    except Exception as _e_mr:
        return f"## R\u00e9gime de March\u00e9\n\n*Erreur lecture regime_log : {_e_mr}*\n\n"
