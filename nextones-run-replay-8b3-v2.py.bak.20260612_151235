# nextones-run-replay-8b3-v2.py
# Smoke-test Jalon 8B.3 - Execution Engine Wrapper (API v2 : open_run + run + close_run)
#
# Pipeline :
#   1. ReplayOrchestrator(label, window_start, window_end, initial_capital, db_path, verbose).open_run() -> run_id
#   2. orch.run(max_cycles=None) -> stats dict
#   3. orch.close_run(status='done')
#
# Checks (9) :
#   1) replay_runs status='done'
#   2) replay_cycles = 3
#   3) Convergence + targets + history (sanity 8B.2)
#   4) cash bouge (< K et > 0)
#   5) replay_orders > 0
#   6) replay_fills > 0 (fill_price>0, slippage_bps>=0)
#   7) replay_positions > 0
#   8) replay_nav_history = 3 et NAV evolue
#   9) Integrity sum(buy_notional) - sum(sell_notional) ~= K - cash_final

import os
import sys
import sqlite3
import datetime
import traceback

PROD_DIR = r"C:\Users\RichardGUELIN\Prod\ThesiumDesk"
DB = os.path.join(PROD_DIR, "thesium.db")
INITIAL_CAPITAL = 1_000_000.0

sys.path.insert(0, PROD_DIR)


def log(msg=""):
    print(msg, flush=True)


def section(title):
    log("")
    log("=" * 72)
    log(title)
    log("=" * 72)


def main():
    section("SMOKE-TEST 8B.3 - Execution Engine Wrapper (API v2)")
    log(f"DB         : {DB}")
    log(f"Initial K  : ${INITIAL_CAPITAL:,.2f}")

    if not os.path.exists(DB):
        log("FAIL : DB introuvable")
        sys.exit(1)

    # 0) Cleanup orphelins running
    cleanup_conn = sqlite3.connect(DB, timeout=10.0)
    n_orphan = cleanup_conn.execute(
        "UPDATE replay_runs SET status='aborted', finished_at=datetime('now') "
        "WHERE status='running'"
    ).rowcount
    cleanup_conn.commit()
    cleanup_conn.close()
    if n_orphan > 0:
        log(f"  Cleanup : {n_orphan} run(s) orphelin(s) marque(s) aborted")

    # 1) Run le replay avec la vraie API
    section("[RUN] Replay 3 cycles : 2026-06-08 -> 2026-06-10")
    from replay_orchestrator import ReplayOrchestrator

    label = f"jalon-8b3-smoke-{datetime.datetime.now().strftime('%Y%m%dT%H%M%S')}"
    orch = ReplayOrchestrator(
        label=label,
        window_start="2026-06-08",
        window_end="2026-06-10",
        initial_capital=INITIAL_CAPITAL,
        db_path=DB,
        verbose=True,
    )

    # NOTE : run() appelle open_run() + close_run() en interne.
    # Le run_id reel est retourne dans stats['run_id'].
    try:
        stats = orch.run(max_cycles=None)
        log(f"\n>>> run() stats : {stats}")
        run_id = stats.get("run_id")
        if run_id is None:
            log("FAIL : run_id absent dans stats")
            sys.exit(2)
        log(f">>> run_id reel : {run_id}")
    except Exception as e:
        log(f"\nERREUR pendant run() : {type(e).__name__}: {e}")
        traceback.print_exc()
        sys.exit(2)

    # 2) Verifs DB
    section("[CHECKS] Validation 9 criteres")

    conn = sqlite3.connect(DB, timeout=10.0)
    conn.row_factory = sqlite3.Row
    cur = conn.cursor()

    checks = []

    def check(name, ok, detail=""):
        checks.append((name, ok, detail))
        status = "PASS" if ok else "FAIL"
        log(f"  [{status}] {name:48s} {detail}")

    # 1) replay_runs status=done
    row = cur.execute(
        "SELECT run_id, status, window_start, window_end FROM replay_runs WHERE run_id=?",
        (run_id,),
    ).fetchone()
    if row:
        ok = row["status"] == "done"
        check("1. replay_runs status=done", ok, f"status={row['status']}")
    else:
        check("1. replay_runs status=done", False, "row not found")

    # 2) replay_cycles = 3
    n_cycles = cur.execute(
        "SELECT COUNT(*) FROM replay_cycles WHERE run_id=?", (run_id,)
    ).fetchone()[0]
    check("2. replay_cycles = 3", n_cycles == 3, f"n_cycles={n_cycles}")

    # 3) Sanity 8B.2 : conv + targets + history
    n_conv = cur.execute(
        "SELECT COUNT(*) FROM replay_convergence_snapshots WHERE run_id=?", (run_id,)
    ).fetchone()[0]
    n_tgt = cur.execute(
        "SELECT COUNT(*) FROM replay_targets WHERE run_id=?", (run_id,)
    ).fetchone()[0]
    n_hist = cur.execute(
        "SELECT COUNT(*) FROM replay_targets_history WHERE run_id=?", (run_id,)
    ).fetchone()[0]
    check(
        "3. Convergence + targets + history (8B.2)",
        n_conv > 0 and n_tgt >= 15 * 3 and n_hist > 0,
        f"conv={n_conv} targets={n_tgt} hist={n_hist}",
    )

    # 4) cash bouge
    cash_row = cur.execute(
        "SELECT cash FROM replay_nav_history WHERE run_id=? ORDER BY day_t DESC LIMIT 1",
        (run_id,),
    ).fetchone()
    cash_final = cash_row["cash"] if cash_row else None
    if cash_final is None:
        check("4. cash bouge (< K et > 0)", False, "cash_final introuvable")
    else:
        ok = cash_final < INITIAL_CAPITAL and cash_final > 0
        check("4. cash bouge (< K et > 0)", ok, f"cash_final=${cash_final:,.2f}")

    # 5) orders > 0
    n_orders = cur.execute(
        "SELECT COUNT(*) FROM replay_orders WHERE run_id=?", (run_id,)
    ).fetchone()[0]
    n_buys = cur.execute(
        "SELECT COUNT(*) FROM replay_orders WHERE run_id=? AND side='BUY'", (run_id,)
    ).fetchone()[0]
    n_sells = cur.execute(
        "SELECT COUNT(*) FROM replay_orders WHERE run_id=? AND side='SELL'", (run_id,)
    ).fetchone()[0]
    check("5. replay_orders > 0", n_orders > 0,
          f"orders={n_orders} (BUY={n_buys} SELL={n_sells})")

    # 6) fills > 0 + valide
    n_fills = cur.execute(
        "SELECT COUNT(*) FROM replay_fills WHERE run_id=?", (run_id,)
    ).fetchone()[0]
    bad_fills = cur.execute(
        "SELECT COUNT(*) FROM replay_fills WHERE run_id=? AND (fill_price<=0 OR slippage_bps<0)",
        (run_id,),
    ).fetchone()[0]
    check("6. replay_fills > 0 (prix>0, slip>=0)",
          n_fills > 0 and bad_fills == 0,
          f"fills={n_fills} bad={bad_fills}")

    # 7) positions > 0 cycle final
    last_cir = cur.execute(
        "SELECT MAX(cycle_id) FROM replay_cycles WHERE run_id=?", (run_id,)
    ).fetchone()[0]
    n_pos = cur.execute(
        "SELECT COUNT(*) FROM replay_positions WHERE run_id=? AND cycle_id_replay=?",
        (run_id, last_cir),
    ).fetchone()[0]
    check("7. replay_positions (snapshot final) > 0",
          n_pos > 0, f"positions_final={n_pos}")

    # 8) NAV history = 3 et evolue
    nav_rows = cur.execute(
        "SELECT day_t, nav, cash, positions_value, daily_pnl, daily_pnl_pct "
        "FROM replay_nav_history WHERE run_id=? ORDER BY day_t",
        (run_id,),
    ).fetchall()
    n_nav = len(nav_rows)
    navs = [r["nav"] for r in nav_rows]
    nav_evolves = len(set(round(n, 2) for n in navs)) > 1 if navs else False
    check("8. replay_nav_history = 3 et NAV evolue",
          n_nav == 3 and nav_evolves,
          f"navs={[f'{n:,.2f}' for n in navs]}")

    # 9) Integrity sum(notional) ~= K - cash
    buy_not = cur.execute(
        "SELECT COALESCE(SUM(notional),0) FROM replay_fills WHERE run_id=? AND side='BUY'",
        (run_id,),
    ).fetchone()[0]
    sell_not = cur.execute(
        "SELECT COALESCE(SUM(notional),0) FROM replay_fills WHERE run_id=? AND side='SELL'",
        (run_id,),
    ).fetchone()[0]
    net = buy_not - sell_not
    cash_decr = INITIAL_CAPITAL - (cash_final if cash_final else INITIAL_CAPITAL)
    diff = abs(net - cash_decr)
    check("9. Integrity sum(notional) == K - cash",
          diff < INITIAL_CAPITAL * 0.001,
          f"buy=${buy_not:,.2f} sell=${sell_not:,.2f} net=${net:,.2f} cash_decr=${cash_decr:,.2f} diff=${diff:.2f}")

    # Detail orders
    section("[DETAIL] Orders breakdown")
    rows = cur.execute(
        "SELECT day_t, COUNT(*) as n, "
        "SUM(CASE WHEN side='BUY' THEN 1 ELSE 0 END) as nb_buy, "
        "SUM(CASE WHEN side='SELL' THEN 1 ELSE 0 END) as nb_sell, "
        "SUM(CASE WHEN status='filled' THEN 1 ELSE 0 END) as nb_filled, "
        "SUM(CASE WHEN status='rejected' THEN 1 ELSE 0 END) as nb_rejected "
        "FROM replay_orders WHERE run_id=? GROUP BY day_t ORDER BY day_t",
        (run_id,),
    ).fetchall()
    log("  day_t       | n   | BUY | SELL| filled | rejected")
    log("  " + "-" * 60)
    for r in rows:
        log(f"  {r['day_t']}  | {r['n']:>3d} | {r['nb_buy']:>3d} | {r['nb_sell']:>3d} | "
            f"{r['nb_filled']:>6d} | {r['nb_rejected']:>8d}")

    # NAV evolution
    section("[DETAIL] NAV evolution")
    log("  day_t       | NAV           | cash          | pos_value     | daily_pnl   | %")
    log("  " + "-" * 90)
    for r in nav_rows:
        pct = r["daily_pnl_pct"] if r["daily_pnl_pct"] is not None else 0.0
        log(f"  {r['day_t']}  | ${r['nav']:>12,.2f} | ${r['cash']:>12,.2f} | "
            f"${r['positions_value']:>12,.2f} | ${r['daily_pnl']:>10,.2f} | {pct:>6.3f}%")

    # Top 5 positions
    section("[DETAIL] Top 5 positions (cycle final)")
    pos_rows = cur.execute(
        "SELECT ticker, quantity, avg_cost, current_price, weight_pct, unrealized_pnl "
        "FROM replay_positions WHERE run_id=? AND cycle_id_replay=? "
        "ORDER BY ABS(weight_pct) DESC LIMIT 5",
        (run_id, last_cir),
    ).fetchall()
    log("  ticker  | qty       | avg_cost  | px_now    | weight%  | unreal_pnl")
    log("  " + "-" * 70)
    for r in pos_rows:
        log(f"  {r['ticker']:<8s}| {r['quantity']:>9.2f} | {r['avg_cost']:>9.2f} | "
            f"{r['current_price']:>9.2f} | {r['weight_pct']:>7.3f}% | ${r['unrealized_pnl']:>10,.2f}")

    conn.close()

    # Verdict
    section("VERDICT 8B.3")
    n_pass = sum(1 for _, ok, _ in checks if ok)
    n_total = len(checks)
    log(f"  Score : {n_pass}/{n_total}")
    for name, ok, detail in checks:
        mark = "[PASS]" if ok else "[FAIL]"
        log(f"    {mark} {name}")

    if n_pass == n_total:
        log("\n  >>> Jalon 8B.3 DONE - Execution Engine wrapper OPERATIONNEL")
        sys.exit(0)
    else:
        log(f"\n  >>> {n_total - n_pass} checks failed - investiguer")
        sys.exit(3)


if __name__ == "__main__":
    main()
