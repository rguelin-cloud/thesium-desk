def _align_dates(all_prices: dict[str, list[dict]]) -> tuple[list[str], dict[str, dict[str, float]]]:
    """
    Align all tickers to common dates.
    Returns (sorted_dates, {ticker: {date: close}}).
    """
    ticker_maps = {}
    all_dates = set()
    for ticker, records in all_prices.items():
        m = {r["date"]: r["close"] for r in records}
        ticker_maps[ticker] = m
        all_dates.update(m.keys())

    # Keep only dates where ALL tickers have data
    common_dates = sorted(all_dates)
    # Forward-fill: for each ticker, fill missing dates with previous close
    filled_maps = {}
    for ticker, m in ticker_maps.items():
        filled = {}
        last_val = None
        for d in common_dates:
            if d in m:
                last_val = m[d]
            if last_val is not None:
                filled[d] = last_val
        filled_maps[ticker] = filled

    # Find dates where all tickers have values
    valid_dates = [d for d in common_dates if all(d in filled_maps[t] for t in filled_maps)]
    return valid_dates, filled_maps


def run_backtest(
    tickers: list[str],
    asset_classes: dict[str, str],
    weights: Optional[dict[str, float]] = None,
    months: int = 12,
    initial_capital: float = 100000.0,
    benchmark: str = "SPY",
    apply_regime: bool = False,
) -> dict:
    """
    Run a portfolio backtest.

    Args:
        tickers: List of tickers to include
        asset_classes: {ticker: asset_class} mapping
        weights: {ticker: weight} — if None, uses equal weight
        months: Lookback period (12, 24 or 60)
        initial_capital: Starting capital
        benchmark: Benchmark ticker for comparison

    Returns:
        {
            portfolio_equity: [{date, value}],
            benchmark_equity: [{date, value}],
            stats: {total_return, annualized_return, volatility, sharpe, max_drawdown, ...},
            benchmark_stats: {...},
            per_asset: [{ticker, weight, return, contribution}],
        }
    """
    if not tickers:
        return {"error": "Aucun ticker fourni"}

    # Default to equal weight
    if weights is None:
        w = 1.0 / len(tickers)
        weights = {t: w for t in tickers}

    # Normalize weights to sum to 1
    total_w = sum(weights.values())
    if total_w > 0:
        weights = {t: w / total_w for t, w in weights.items()}

    # Fetch all price data
    all_prices = {}
    for ticker in tickers:
        ac = asset_classes.get(ticker, "equity")
        data = fetch_prices(ticker, ac, months)
        if data and len(data) >= 10:
            all_prices[ticker] = data
        else:
            print(f"[backtest] Skipping {ticker}: insufficient data ({len(data)} records)")

    if not all_prices:
        return {"error": "Aucune donnée de prix disponible"}

    # Fetch benchmark
    bench_data = fetch_prices(benchmark, "etf", months)
    if bench_data:
        all_prices[f"__bench_{benchmark}"] = bench_data

    # Align dates
    dates, price_maps = _align_dates(all_prices)
    if len(dates) < 10:
        return {"error": f"Seulement {len(dates)} jours communs — données insuffisantes"}

    # Recalculate weights for available tickers only
    available = [t for t in tickers if t in price_maps]
    if not available:
        return {"error": "Aucun ticker disponible après alignement"}

    avail_weights = {t: weights.get(t, 0) for t in available}
    total_aw = sum(avail_weights.values())
    if total_aw > 0:
        avail_weights = {t: w / total_aw for t, w in avail_weights.items()}

    # Calculate daily returns per ticker
    daily_returns = {}
    for ticker in available:
        returns = []
        pm = price_maps[ticker]
        for i in range(1, len(dates)):
            prev = pm[dates[i - 1]]
            curr = pm[dates[i]]
            if prev > 0:
                returns.append((curr - prev) / prev)
            else:
                returns.append(0.0)
        daily_returns[ticker] = returns

    # Portfolio daily returns (weighted sum)
    port_returns = []
    for i in range(len(dates) - 1):
        day_ret = sum(avail_weights[t] * daily_returns[t][i] for t in available)
        port_returns.append(day_ret)

    # Portfolio equity curve
    port_equity = [{"date": dates[0], "value": initial_capital}]
    value = initial_capital
    for i, ret in enumerate(port_returns):
        value *= (1 + ret)
        port_equity.append({"date": dates[i + 1], "value": round(value, 2)})

    # Benchmark equity curve
    bench_key = f"__bench_{benchmark}"
    bench_equity = []
    bench_stats = {}
    if bench_key in price_maps:
        bm = price_maps[bench_key]
        bench_start = bm[dates[0]]
        bench_eq = []
        for d in dates:
            bv = (bm[d] / bench_start) * initial_capital if bench_start > 0 else initial_capital
            bench_eq.append({"date": d, "value": round(bv, 2)})
        bench_equity = bench_eq

        # Benchmark returns
        bench_returns = []
        for i in range(1, len(dates)):
            prev = bm[dates[i - 1]]
            curr = bm[dates[i]]
            if prev > 0:
                bench_returns.append((curr - prev) / prev)
            else:
                bench_returns.append(0.0)
        bench_stats = _compute_stats(bench_returns, initial_capital, bench_equity)

    # Per-asset performance
    per_asset = []
    for t in available:
        pm = price_maps[t]
        start_p = pm[dates[0]]
        end_p = pm[dates[-1]]
        asset_ret = (end_p - start_p) / start_p if start_p > 0 else 0
        contribution = asset_ret * avail_weights[t]
        per_asset.append({
            "ticker": t,
            "weight": round(avail_weights[t] * 100, 1),
            "return_pct": round(asset_ret * 100, 2),
            "contribution_pct": round(contribution * 100, 2),
        })
    per_asset.sort(key=lambda x: x["return_pct"], reverse=True)

    # Trade journal — daily log per asset
    trade_journal = []
    for t in available:
        pm = price_maps[t]
        weight = avail_weights[t]
        position_value = initial_capital * weight
        cumul_return = 0.0
        for i, d in enumerate(dates):
            price = pm[d]
            if i == 0:
                daily_ret = 0.0
                cumul_return = 0.0
                position_value = initial_capital * weight
            else:
                prev_price = pm[dates[i - 1]]
                daily_ret = (price - prev_price) / prev_price if prev_price > 0 else 0.0
                cumul_return = (price - pm[dates[0]]) / pm[dates[0]] if pm[dates[0]] > 0 else 0.0
                position_value = initial_capital * weight * (1 + cumul_return)
            trade_journal.append({
                "date": d,
                "ticker": t,
                "poids_pct": round(weight * 100, 2),
                "prix": round(price, 4),
                "rendement_jour_pct": round(daily_ret * 100, 4),
                "rendement_cumul_pct": round(cumul_return * 100, 4),
                "valeur_position": round(position_value, 2),
            })

    # Portfolio stats
    stats = _compute_stats(port_returns, initial_capital, port_equity)


    # [PATCH_BACKTEST_ENGINE_REGIME_V1] - regime-aware overlay
    regime_overlay = None
    if apply_regime:
        regime_overlay = _compute_regime_overlay(
            dates=dates,
            price_maps=price_maps,
            asset_classes=asset_classes,
            available=available,
            avail_weights=avail_weights,
            daily_returns=daily_returns,
            initial_capital=initial_capital,
            benchmark=benchmark,
        )

    return {
        "portfolio_equity": port_equity,
        "benchmark_equity": bench_equity,
        "benchmark_ticker": benchmark,
        "stats": stats,
        "benchmark_stats": bench_stats,
        "per_asset": per_asset,
        "trade_journal": trade_journal,
        "period_days": len(dates),
        "start_date": dates[0],
        "end_date": dates[-1],
        "tickers_used": available,
        "tickers_skipped": [t for t in tickers if t not in available],
        # [PATCH_BACKTEST_ENGINE_REGIME_V1]
        "portfolio_equity_regime": regime_overlay["equity"] if regime_overlay else None,
        "stats_regime": regime_overlay["stats"] if regime_overlay else None,
        "regime_timeline": regime_overlay["timeline"] if regime_overlay else None,
        "regime_summary": regime_overlay["summary"] if regime_overlay else None,
        "apply_regime": bool(apply_regime),
    }


def _compute_stats(returns: list[float], initial_capital: float, equity: list[dict]) -> dict:
    """Compute key portfolio statistics."""
    if not returns:
        return {}

    n = len(returns)
    total_return = 1
    for r in returns:
        total_return *= (1 + r)
    total_return -= 1

    # Annualized return
    years = n / 252
    ann_return = (1 + total_return) ** (1 / years) - 1 if years > 0 else 0

    # Volatility (annualized)
    mean_ret = sum(returns) / n
    variance = sum((r - mean_ret) ** 2 for r in returns) / n
    daily_vol = math.sqrt(variance)
    ann_vol = daily_vol * math.sqrt(252)

    # Sharpe (risk-free ~ 4.5% as of 2026)
    rf = 0.045
    sharpe = (ann_return - rf) / ann_vol if ann_vol > 0 else 0

    # Sortino (downside deviation)
    neg_returns = [r for r in returns if r < 0]
    if neg_returns:
        downside_var = sum(r ** 2 for r in neg_returns) / len(neg_returns)
        downside_dev = math.sqrt(downside_var) * math.sqrt(252)
        sortino = (ann_return - rf) / downside_dev if downside_dev > 0 else 0
    else:
        sortino = float("inf")

    # Max drawdown
    peak = 0
    max_dd = 0
    for e in equity:
        v = e["value"]
        if v > peak:
            peak = v
        dd = (peak - v) / peak if peak > 0 else 0
        if dd > max_dd:
            max_dd = dd

    # Calmar ratio
    calmar = ann_return / max_dd if max_dd > 0 else 0

    # Win rate
    wins = sum(1 for r in returns if r > 0)
    win_rate = wins / n if n > 0 else 0

    # Best / worst day
    best_day = max(returns) if returns else 0
    worst_day = min(returns) if returns else 0

    return {
        "total_return_pct": round(total_return * 100, 2),
        "annualized_return_pct": round(ann_return * 100, 2),
        "volatility_pct": round(ann_vol * 100, 2),
        "sharpe": round(sharpe, 2),
        "sortino": round(sortino, 2),
        "max_drawdown_pct": round(max_dd * 100, 2),
        "calmar": round(calmar, 2),
        "win_rate_pct": round(win_rate * 100, 1),
        "best_day_pct": round(best_day * 100, 2),
        "worst_day_pct": round(worst_day * 100, 2),
        "trading_days": n,
        "final_value": round(equity[-1]["value"], 2) if equity else initial_capital,
    }


# [PATCH_BACKTEST_ENGINE_REGIME_V1]
def _compute_regime_overlay(
    dates,
    price_maps,
    asset_classes,
    available,
    avail_weights,
    daily_returns,
    initial_capital,
    benchmark,
):
    """Compute regime-aware equity curve overlay.

    Rules (proxy of detect_market_regime in production):
      Equity regime per day t based on rolling SPY (or first equity available):
        - realized vol annualized over last 20d
        - drawdown over last 5d (% from rolling peak)
        - VIX proxy = max(20d realized vol, 15.0)  # synthetic when no FRED
      Score:
        - vol >= 25% -> stress signal, vol <= 15% -> calm signal
        - dd <= -5% -> stress, dd >= -2% -> calm
        - vix proxy >= 25 -> stress, <= 15 -> calm
      Regime = STRESS if n_stress >= 2, CALM if n_calm >= 2, else NORMAL

    Crypto regime per day t based on first crypto ticker available:
      vol 20d (annualized), drawdown 5d. Same thresholds but vol 30%/20%.

    Multipliers (must match production market_regime_v1):
        equity:  CALM buy=0.7 sell=1.5 | NORMAL 1.0/1.0 | STRESS buy=1.8 sell=0.5
        crypto:  CALM buy=0.7 sell=1.5 | NORMAL 1.0/1.0 | STRESS buy=1.8 sell=0.5
    Exposure tilt: each ticker weight is multiplied by buy_mult of its regime,
    capped at the base weight (no leverage in backtest), residual goes to cash@Rf.
    """
    import math

    MULTS = {
        'CALM':   {'buy': 0.7, 'sell': 1.5},
        'NORMAL': {'buy': 1.0, 'sell': 1.0},
        'STRESS': {'buy': 1.8, 'sell': 0.5},
    }
    RF_DAILY = (1.0 + 0.045) ** (1.0 / 252.0) - 1.0

    # Pick a proxy ticker for equity regime: prefer SPY benchmark, else first equity
    spy_key = '__bench_' + benchmark
    equity_proxy = None
    if spy_key in price_maps:
        equity_proxy = spy_key
    else:
        for t in available:
            ac = asset_classes.get(t, 'equity')
            if ac in ('equity', 'etf'):
                equity_proxy = t
                break

    # Pick a proxy ticker for crypto regime: first crypto
    crypto_proxy = None
    for t in available:
        if asset_classes.get(t, 'equity') == 'crypto':
            crypto_proxy = t
            break

    def _classify(vol_pct, dd_pct, vix_proxy, asset_class, dd_long_pct=None):
        if asset_class == 'crypto':
            vol_stress, vol_calm = 45.0, 25.0  # [PATCH_BACKTEST_ENGINE_CRYPTO_THRESHOLDS_V1]
            dd_stress, dd_calm = -8.0, -3.0
            dd_long_stress, dd_long_calm = -15.0, -3.0
        else:
            vol_stress, vol_calm = 25.0, 15.0
            dd_stress, dd_calm = -5.0, -2.0
        n_stress = 0
        n_calm = 0
        if vol_pct is not None:
            if vol_pct >= vol_stress: n_stress += 1
            elif vol_pct <= vol_calm: n_calm += 1
        if dd_pct is not None:
            if dd_pct <= dd_stress: n_stress += 1
            elif dd_pct >= dd_calm: n_calm += 1
        if asset_class == 'crypto' and dd_long_pct is not None:  # [PATCH_BACKTEST_ENGINE_CRYPTO_THRESHOLDS_V1]
            if dd_long_pct <= dd_long_stress: n_stress += 1
            elif dd_long_pct >= dd_long_calm: n_calm += 1
        if asset_class != 'crypto' and vix_proxy is not None:
            if vix_proxy >= 25.0: n_stress += 1
            elif vix_proxy <= 15.0: n_calm += 1
        if n_stress >= 2: return 'STRESS'
        if n_calm >= 2: return 'CALM'
        return 'NORMAL'

    def _rolling_metrics(prices_list, lookback_vol=20, lookback_dd=5):
        # prices_list = [p_t-N, ..., p_t]
        if len(prices_list) < 2:
            return None, None
        rets = []
        n = len(prices_list)
        start = max(0, n - lookback_vol - 1)
        sub = prices_list[start:]
        for i in range(1, len(sub)):
            prev = sub[i - 1]
            curr = sub[i]
            if prev > 0:
                rets.append((curr - prev) / prev)
        if not rets:
            return None, None
        mean = sum(rets) / len(rets)
        var = sum((r - mean) ** 2 for r in rets) / len(rets)
        vol_daily = math.sqrt(var)
        vol_ann = vol_daily * math.sqrt(252) * 100.0
        # drawdown over lookback_dd from peak
        dd_window = prices_list[-min(lookback_dd + 1, len(prices_list)):]
        peak = max(dd_window)
        last = dd_window[-1]
        dd = ((last - peak) / peak) * 100.0 if peak > 0 else 0.0
        # dd long 20j (pour signal crypto)  # [PATCH_BACKTEST_ENGINE_CRYPTO_THRESHOLDS_V1]
        dd_long_window = prices_list[-min(21, len(prices_list)):]
        peak_long = max(dd_long_window) if dd_long_window else 0.0
        last_long = dd_long_window[-1] if dd_long_window else 0.0
        dd_long = ((last_long - peak_long) / peak_long) * 100.0 if peak_long > 0 else 0.0
        return vol_ann, dd, dd_long

    # Pre-extract proxy price series
    eq_prices = []
    cr_prices = []
    if equity_proxy:
        for d in dates:
            eq_prices.append(price_maps[equity_proxy][d])
    if crypto_proxy:
        for d in dates:
            cr_prices.append(price_maps[crypto_proxy][d])

    timeline = []
    eq_regimes = []  # per-day regime classification (equity)
    cr_regimes = []  # per-day regime classification (crypto)
    # Need at least 21 days of history for vol_20; before that, default NORMAL
    for i, d in enumerate(dates):
        if equity_proxy and i >= 21:
            vol_e, dd_e, dd_e_long = _rolling_metrics(eq_prices[:i + 1], 20, 5)
            vix_proxy = max(vol_e, 15.0) if vol_e is not None else None
            eq_reg = _classify(vol_e, dd_e, vix_proxy, 'equity')
        else:
            vol_e, dd_e, vix_proxy = None, None, None
            eq_reg = 'NORMAL'
        if crypto_proxy and i >= 21:
            vol_c, dd_c, dd_c_long = _rolling_metrics(cr_prices[:i + 1], 20, 5)
            cr_reg = _classify(vol_c, dd_c, None, 'crypto', dd_long_pct=dd_c_long)
        else:
            vol_c, dd_c = None, None
            cr_reg = 'NORMAL'
        eq_regimes.append(eq_reg)
        cr_regimes.append(cr_reg)
        timeline.append({
            'date': d,
            'equity_regime': eq_reg,
            'crypto_regime': cr_reg,
            'equity_vol_pct': round(vol_e, 2) if vol_e is not None else None,
            'equity_dd_pct': round(dd_e, 2) if dd_e is not None else None,
            'equity_vix_proxy': round(vix_proxy, 2) if vix_proxy is not None else None,
            'crypto_vol_pct': round(vol_c, 2) if vol_c is not None else None,
            'crypto_dd_pct': round(dd_c, 2) if dd_c is not None else None,
        })

    # Build regime-tilted equity curve
    # exposure_eq_t = sum(base_weight[t]) for equity tickers * eq_buy_mult, capped at base
    # exposure_cr_t idem crypto, residual to cash @ RF_DAILY
    base_eq_w = sum(avail_weights[t] for t in available if asset_classes.get(t, 'equity') in ('equity', 'etf'))
    base_cr_w = sum(avail_weights[t] for t in available if asset_classes.get(t, 'equity') == 'crypto')

    # Pre-compute per-bucket daily portfolio returns
    eq_tickers = [t for t in available if asset_classes.get(t, 'equity') in ('equity', 'etf')]
    cr_tickers = [t for t in available if asset_classes.get(t, 'equity') == 'crypto']

    eq_w_norm = {t: (avail_weights[t] / base_eq_w) if base_eq_w > 0 else 0.0 for t in eq_tickers}
    cr_w_norm = {t: (avail_weights[t] / base_cr_w) if base_cr_w > 0 else 0.0 for t in cr_tickers}

    # daily_returns[t] has len = len(dates) - 1, index i = return between dates[i] and dates[i+1]
    eq_bucket_ret = []  # equity bucket pure return at day i+1
    cr_bucket_ret = []
    for i in range(len(dates) - 1):
        eq_r = sum(eq_w_norm[t] * daily_returns[t][i] for t in eq_tickers) if eq_tickers else 0.0
        cr_r = sum(cr_w_norm[t] * daily_returns[t][i] for t in cr_tickers) if cr_tickers else 0.0
        eq_bucket_ret.append(eq_r)
        cr_bucket_ret.append(cr_r)

    # Build equity curve regime: apply exposure tilt using PREVIOUS day regime (no look-ahead)
    port_equity_regime = [{'date': dates[0], 'value': initial_capital}]
    port_returns_regime = []
    value = initial_capital
    trades_avoided = 0  # cumul of |delta_exposure| / day where mult != 1
    take_profits = 0
    for i in range(len(dates) - 1):
        # Use regime at day i (prior to return between i and i+1)
        eq_reg = eq_regimes[i]
        cr_reg = cr_regimes[i]
        eq_mult = MULTS[eq_reg]['buy']
        cr_mult = MULTS[cr_reg]['buy']
        # Cap mult at 1.0 (no leverage in backtest)
        eq_expo = min(base_eq_w * eq_mult, base_eq_w + (1.0 - base_eq_w - base_cr_w))  # cap at 1.0 total
        cr_expo = min(base_cr_w * cr_mult, base_cr_w + (1.0 - base_eq_w - base_cr_w))
        if eq_expo + cr_expo > 1.0:
            scale = 1.0 / (eq_expo + cr_expo)
            eq_expo *= scale
            cr_expo *= scale
        cash_expo = max(0.0, 1.0 - eq_expo - cr_expo)
        day_r = eq_expo * eq_bucket_ret[i] + cr_expo * cr_bucket_ret[i] + cash_expo * RF_DAILY
        port_returns_regime.append(day_r)
        value *= (1.0 + day_r)
        port_equity_regime.append({'date': dates[i + 1], 'value': round(value, 2)})
        # Count actions
        if eq_reg == 'CALM' or cr_reg == 'CALM':
            take_profits += 1
        if eq_reg == 'STRESS' or cr_reg == 'STRESS':
            trades_avoided += 1

    stats_regime = _compute_stats(port_returns_regime, initial_capital, port_equity_regime)

    # Summary
    eq_counts = {'CALM': 0, 'NORMAL': 0, 'STRESS': 0}
    cr_counts = {'CALM': 0, 'NORMAL': 0, 'STRESS': 0}
    for r in eq_regimes:
        eq_counts[r] = eq_counts.get(r, 0) + 1
    for r in cr_regimes:
        cr_counts[r] = cr_counts.get(r, 0) + 1

    summary = {
        'equity': {
            'calm_days': eq_counts['CALM'],
            'normal_days': eq_counts['NORMAL'],
            'stress_days': eq_counts['STRESS'],
        },
        'crypto': {
            'calm_days': cr_counts['CALM'],
            'normal_days': cr_counts['NORMAL'],
            'stress_days': cr_counts['STRESS'],
        },
        'trades_avoided_days': trades_avoided,
        'take_profits_days': take_profits,
        'base_equity_weight_pct': round(base_eq_w * 100, 2),
        'base_crypto_weight_pct': round(base_cr_w * 100, 2),
    }

    return {
        'equity': port_equity_regime,
        'stats': stats_regime,
        'timeline': timeline,
        'summary': summary,
    }

