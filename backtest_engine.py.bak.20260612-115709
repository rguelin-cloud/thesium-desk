"""
backtest_engine.py — Portfolio backtester for Nextones Desk
Uses Yahoo Finance for all assets (equities, ETFs, and crypto via TICKER-USD).
Supports equal-weight and custom-weight portfolios over 12/24-month windows.
"""
import json
import math
import time
import urllib.request
from datetime import datetime, timedelta
from typing import Optional

# ---------------------------------------------------------------------------
# Data fetching — Yahoo Finance for everything
# ---------------------------------------------------------------------------

def _fetch_yahoo(ticker: str, period: str = "1y") -> list[dict]:
    """Fetch daily close prices from Yahoo Finance."""
    try:
        import yfinance as yf
        df = yf.download(ticker, period=period, progress=False, auto_adjust=True)
        if df.empty:
            return []
        records = []
        for date, row in df.iterrows():
            close_val = row["Close"]
            if hasattr(close_val, "iloc"):
                close_val = close_val.iloc[0]
            records.append({
                "date": date.strftime("%Y-%m-%d"),
                "close": float(close_val),
            })
        return records
    except Exception as e:
        print(f"[backtest] Yahoo error for {ticker}: {e}")
        return []


# Yahoo Finance crypto tickers (TICKER-USD format)
CRYPTO_YAHOO = {
    'BTC': 'BTC-USD', 'ETH': 'ETH-USD', 'XRP': 'XRP-USD',
    'BNB': 'BNB-USD', 'SOL': 'SOL-USD', 'DOGE': 'DOGE-USD',
    'ADA': 'ADA-USD', 'TRX': 'TRX-USD', 'LINK': 'LINK-USD',
    'AVAX': 'AVAX-USD', 'SUI': 'SUI20947-USD', 'XLM': 'XLM-USD',
    'TON': 'TON11419-USD', 'SHIB': 'SHIB-USD', 'HBAR': 'HBAR-USD',
    'DOT': 'DOT-USD', 'BCH': 'BCH-USD', 'LTC': 'LTC-USD',
    'UNI': 'UNI7083-USD', 'NEAR': 'NEAR-USD', 'APT': 'APT21794-USD',
    'ICP': 'ICP-USD', 'ATOM': 'ATOM-USD',
    'RENDER': 'RENDER-USD',
}


def fetch_prices(ticker: str, asset_class: str, months: int = 12) -> list[dict]:
    """Fetch daily close prices for a ticker via Yahoo Finance."""
    if months <= 12:
        period = "1y"
    elif months <= 24:
        period = "2y"
    else:
        period = "5y"
    if asset_class == "crypto":
        yf_ticker = CRYPTO_YAHOO.get(ticker, f"{ticker}-USD")
        return _fetch_yahoo(yf_ticker, period=period)
    else:
        return _fetch_yahoo(ticker, period=period)


