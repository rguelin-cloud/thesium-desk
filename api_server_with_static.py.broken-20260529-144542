def _univ_conn():
    import sqlite3
    c = sqlite3.connect(str(DB_PATH), timeout=30.0)
    c.execute("PRAGMA busy_timeout=30000;")
    c.row_factory = sqlite3.Row
    return c


@app.get("/api/universe/candidates")
async def list_universe_candidates(
    status: str = Query("pending", description="pending | approved | rejected | all"),
    limit: int = Query(50, ge=1, le=500),
    current_user=Depends(get_current_user),
):
    """Liste les candidats par statut."""
    conn = _univ_conn()
    try:
        if status == "all":
            cur = conn.execute(
                "SELECT * FROM universe_candidates ORDER BY proposed_at DESC, score DESC LIMIT ?;",
                (limit,),
            )
        else:
            cur = conn.execute(
                "SELECT * FROM universe_candidates WHERE status = ? "
                "ORDER BY proposed_at DESC, score DESC LIMIT ?;",
                (status, limit),
            )
        rows = [dict(r) for r in cur.fetchall()]
        return {"count": len(rows), "status_filter": status, "candidates": rows}
    finally:
        conn.close()


@app.get("/api/universe/candidates/{candidate_id}")
async def get_universe_candidate(candidate_id: int, current_user=Depends(get_current_user)):
    conn = _univ_conn()
    try:
        cur = conn.execute("SELECT * FROM universe_candidates WHERE id = ?;", (candidate_id,))
        row = cur.fetchone()
        if not row:
            raise HTTPException(status_code=404, detail="candidate_not_found")
        return {"candidate": dict(row)}
    finally:
        conn.close()


@app.post("/api/universe/candidates/{candidate_id}/approve")
async def approve_universe_candidate(
    candidate_id: int,
    payload: Optional[dict] = Body(default=None),
    current_user=Depends(get_current_user),
):
    """Approuve un candidat. Insert dans instruments + target_universe."""
    if _univ_approve is None:
        raise HTTPException(status_code=503, detail="universe_expansion_agent_unavailable")
    reviewer = getattr(current_user, "username", None) or "system"
    max_w = None
    if payload and isinstance(payload, dict):
        v = payload.get("max_weight_pct")
        if v is not None:
            try:
                max_w = float(v)
            except Exception:
                pass
    result = _univ_approve(candidate_id, reviewed_by=reviewer, max_weight_pct=max_w)
    if not result.get("ok"):
        raise HTTPException(status_code=400, detail=result)
    return result


@app.post("/api/universe/candidates/{candidate_id}/reject")
async def reject_universe_candidate(
    candidate_id: int,
    payload: Optional[dict] = Body(default=None),
    current_user=Depends(get_current_user),
):
    if _univ_reject is None:
        raise HTTPException(status_code=503, detail="universe_expansion_agent_unavailable")
    reviewer = getattr(current_user, "username", None) or "system"
    notes = (payload or {}).get("notes") if payload else None
    result = _univ_reject(candidate_id, reviewed_by=reviewer, notes=notes)
    if not result.get("ok"):
        raise HTTPException(status_code=400, detail=result)
    return result


@app.post("/api/universe/scan")
async def universe_scan(
    payload: Optional[dict] = Body(default=None),
    current_user=Depends(get_current_user),
):
    """Lance un scan manuel (admin only)."""
    if _univ_run_scan is None:
        raise HTTPException(status_code=503, detail="universe_expansion_agent_unavailable")
    role = getattr(current_user, "role", None)
    if role and role not in ("admin", "manager"):
        raise HTTPException(status_code=403, detail="forbidden_role")
    top = 5
    dry = False
    if payload and isinstance(payload, dict):
        top = int(payload.get("top", 5))
        dry = bool(payload.get("dry_run", False))
    return _univ_run_scan(top_n=top, dry_run=dry)


