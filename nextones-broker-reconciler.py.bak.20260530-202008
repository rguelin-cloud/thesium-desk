def banner(t):
    print()
    print("=" * 60)
    print(t)
    print("=" * 60)


def open_db():
    c = sqlite3.connect(DB, timeout=10.0)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA busy_timeout=10000")
    return c



# [NEXTONES-BROKER-RECONCILER-V2] helper resolver
_RESOLVER_MOD = None


def _load_resolver():
    """Charge nextones-broker-resolver.py par chemin (- dans le nom)."""
    global _RESOLVER_MOD
    if _RESOLVER_MOD is not None:
        return _RESOLVER_MOD
    import importlib.util as _ilu
    here = os.path.dirname(os.path.abspath(__file__))
    p = os.path.join(here, "nextones-broker-resolver.py")
    if not os.path.exists(p):
        print("[WARN] nextones-broker-resolver.py introuvable : " + p)
        return None
    spec = _ilu.spec_from_file_location("_nx_resolver", p)
    mod = _ilu.module_from_spec(spec)
    try:
        spec.loader.exec_module(mod)
        _RESOLVER_MOD = mod
        return mod
    except Exception as e:
        print(f"[WARN] resolver import KO : {e}")
        return None


def resolve_via_resolver(thesium_ticker, con=None):
    """Retourne dict { broker_symbol, contract_size, lot_step, source }
    ou None si non resolvable."""
    mod = _load_resolver()
    if mod is None:
        return None
    fn = getattr(mod, "resolve", None)
    if fn is None:
        return None
    try:
        # signatures possibles : resolve(ticker, conn=...) ou resolve(ticker)
        try:
            res = fn(thesium_ticker, conn=con) if con else fn(thesium_ticker)
        except TypeError:
            res = fn(thesium_ticker)
    except Exception as e:
        print(f"[WARN] resolver({thesium_ticker}) exc : {e}")
        return None
    if res is None:
        return None
    # Cas 1 : dataclass BrokerMatch (cas reel du resolver)
    bs = getattr(res, "broker_symbol", None)
    if bs is not None or hasattr(res, "thesium_ticker"):
        if not bs:
            return None
        return {
            "broker_symbol": bs,
            "contract_size": float(getattr(res, "contract_size", None) or 1.0),
            "lot_step": float(getattr(res, "lot_step", None) or 0.01),
            "source": getattr(res, "source", None) or "resolver",
            "asset_class": getattr(res, "asset_class", None),
            "tradable": getattr(res, "tradable", True),
        }
    # Cas 2 : dict (anciennes API)
    if isinstance(res, dict):
        bs = res.get("broker_symbol")
        if not bs:
            return None
        specs = res.get("specs") or res.get("diagnostics", {}).get("specs") or {}
        return {
            "broker_symbol": bs,
            "contract_size": float(specs.get("contract_size", 1.0)),
            "lot_step": float(specs.get("lot_step", 0.01)),
            "source": res.get("source") or res.get("resolver_source") or "resolver",
            "asset_class": res.get("asset_class")
            or res.get("diagnostics", {}).get("asset_class"),
        }
    return None


# [/NEXTONES-BROKER-RECONCILER-V2] helper resolver

def now_iso():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


# ----------------------------- 1 -----------------------------
def fetch_thesium_positions(con):
    """Retourne dict { thesium_ticker -> { 'qty': float, 'instrument_id': int,
       'avg_price': float, 'last_price': float } }"""
    # Schema portfolio_positions (vu en diag) :
    # id, instrument_id, quantity, ...
    # Schema verifie via PRAGMA
    cols = [r[1] for r in con.execute("PRAGMA table_info(portfolio_positions)").fetchall()]
    qty_col = "quantity" if "quantity" in cols else "qty"
    avg_col = None
    for c in ("avg_price", "average_price", "entry_price", "cost_basis"):
        if c in cols:
            avg_col = c
            break

    base_sql = f"""
        SELECT
            i.ticker AS thesium_ticker,
            i.id AS instrument_id,
            p.{qty_col} AS qty,
            { 'p.' + avg_col + ' AS avg_price' if avg_col else 'NULL AS avg_price' },
            (SELECT close FROM prices
             WHERE instrument_id = i.id ORDER BY date DESC LIMIT 1) AS last_price
        FROM portfolio_positions p
        JOIN instruments i ON i.id = p.instrument_id
        WHERE p.{qty_col} IS NOT NULL AND ABS(p.{qty_col}) > 1e-9
    """
    out = {}
    for r in con.execute(base_sql):
        out[r["thesium_ticker"]] = {
            "instrument_id": r["instrument_id"],
            "qty": float(r["qty"]) if r["qty"] is not None else 0.0,
            "avg_price": float(r["avg_price"]) if r["avg_price"] is not None else None,
            "last_price": float(r["last_price"]) if r["last_price"] is not None else None,
        }
    return out


# ----------------------------- 2 -----------------------------
def fetch_broker_positions(verbose=False):
    """Retourne list[dict] des positions ActivTrades via MetaAPI.

    Format : [{ symbol, volume, type ('POSITION_TYPE_BUY/SELL'), openPrice,
                currentPrice, profit, ... }, ...]"""
    try:
        import metaapi_provider as mp
    except Exception as e:
        print(f"[WARN] metaapi_provider non importable : {e}")
        return None, "metaapi_provider_missing"

    if not mp.is_configured():
        print("[WARN] MetaAPI non configure (METAAPI_TOKEN / METAAPI_ACCOUNT_ID)")
        return None, "not_configured"

    try:
        positions = mp.get_positions()
        if verbose:
            print(f"  [debug] {len(positions)} position(s) brutes :")
            for p in positions[:10]:
                if isinstance(p, dict):
                    print(f"    {p.get('symbol')} vol={p.get('volume')} "
                          f"type={p.get('type')} openPrice={p.get('openPrice')}")
        return positions or [], None
    except Exception as e:
        print(f"[WARN] erreur fetch broker positions : {e}")
        return None, str(e)


# ----------------------------- 3 -----------------------------
def fetch_mappings(con, thesium_tickers=None):
    """Retourne dict { broker_symbol -> { 'thesium_ticker', 'contract_size',
       'lot_step' } } et son inverse."""
    cols = [r[1] for r in con.execute(
        "PRAGMA table_info(instrument_broker_mapping)"
    ).fetchall()]
    has_cs = "contract_size" in cols
    has_ls = "lot_step" in cols

    sql = f"""
        SELECT
            thesium_ticker, broker_symbol,
            { 'contract_size' if has_cs else 'NULL AS contract_size' },
            { 'lot_step' if has_ls else 'NULL AS lot_step' }
        FROM instrument_broker_mapping
        WHERE broker_symbol IS NOT NULL AND broker_symbol <> ''
    """
    by_broker = {}
    by_thesium = {}
    for r in con.execute(sql):
        d = {
            "thesium_ticker": r["thesium_ticker"],
            "broker_symbol": r["broker_symbol"],
            "contract_size": (float(r["contract_size"])
                              if r["contract_size"] is not None else 1.0),
            "lot_step": (float(r["lot_step"])
                         if r["lot_step"] is not None else 0.01),
        }
        by_broker[r["broker_symbol"]] = d
        by_thesium[r["thesium_ticker"]] = d

    # [NEXTONES-BROKER-RECONCILER-V2] completion via resolver
    if thesium_tickers:
        for t in thesium_tickers:
            if t in by_thesium:
                continue
            r = resolve_via_resolver(t, con)
            if r is None:
                continue
            d = {
                "thesium_ticker": t,
                "broker_symbol": r["broker_symbol"],
                "contract_size": r["contract_size"],
                "lot_step": r["lot_step"],
            }
            by_broker[r["broker_symbol"]] = d
            by_thesium[t] = d
    # [/NEXTONES-BROKER-RECONCILER-V2]
    return by_broker, by_thesium


# ----------------------------- 4 -----------------------------
def normalize_broker_position(p, mapping_by_broker):
    """Calcule qty signee (BUY positive, SELL negative) + notional approche."""
    symbol = p.get("symbol")
    volume = float(p.get("volume", 0.0))  # en lots
    side = p.get("type", "")
    open_price = float(p.get("openPrice", 0.0)) if p.get("openPrice") else 0.0
    current_price = float(p.get("currentPrice", 0.0)) if p.get("currentPrice") else None

    # qty signee : SELL => negatif
    qty_signed = volume if "BUY" in side.upper() else -volume

    # Conversion lots -> units via contract_size
    map_info = mapping_by_broker.get(symbol)
    contract_size = map_info["contract_size"] if map_info else 1.0
    qty_units = qty_signed * contract_size

    # Notional en USD (approximatif : on suppose quote USD pour broker symbol)
    notional_usd = (abs(qty_units) * (current_price or open_price)
                    if (current_price or open_price) else None)

    return {
        "broker_symbol": symbol,
        "thesium_ticker": map_info["thesium_ticker"] if map_info else None,
        "volume_lots": volume,
        "qty_units_signed": qty_units,
        "open_price": open_price,
        "current_price": current_price,
        "notional_usd": notional_usd,
        "side": "buy" if qty_signed > 0 else "sell",
        "raw": p,
    }


# ----------------------------- 5 -----------------------------
def reconcile(thesium_positions, broker_positions_norm, mapping_by_broker,
              mapping_by_thesium):
    """Retourne list[dict] de lignes a inserer dans broker_reconciliation_log.

    Status :
      - 'match'        : qty Thesium ~= qty broker (drift < 1%)
      - 'drift_qty'    : qty Thesium != qty broker
      - 'thesium_only' : position cote Thesium mais pas broker
      - 'broker_only'  : position cote broker mais pas Thesium (ou unmapped)
      - 'unmapped'     : broker_symbol pas dans instrument_broker_mapping
    """
    DRIFT_TOL_PCT = 0.01  # 1%
    rows = []

    # Index broker par thesium_ticker (apres normalisation)
    broker_by_thesium = {}
    for bp in broker_positions_norm:
        tk = bp["thesium_ticker"]
        if tk is None:
            # broker_only unmapped
            rows.append({
                "thesium_ticker": None,
                "broker_symbol": bp["broker_symbol"],
                "qty_thesium": None,
                "qty_broker": bp["qty_units_signed"],
                "qty_drift": None,
                "qty_drift_pct": None,
                "notional_thesium_usd": None,
                "notional_broker_usd": bp["notional_usd"],
                "notional_drift_usd": None,
                "status": "unmapped",
                "details": {"raw_broker_symbol": bp["broker_symbol"], "raw": str(bp["raw"])[:300]},
            })
        else:
            # On accumule (en cas de plusieurs positions broker sur meme symbol)
            broker_by_thesium.setdefault(tk, []).append(bp)

    # Pour chaque thesium ticker on agrege le broker (somme des qty signees)
    broker_agg_by_thesium = {}
    for tk, lst in broker_by_thesium.items():
        qty_sum = sum(p["qty_units_signed"] for p in lst)
        notional_sum = sum((p["notional_usd"] or 0.0) for p in lst)
        broker_agg_by_thesium[tk] = {
            "qty": qty_sum,
            "notional_usd": notional_sum,
            "broker_symbol": lst[0]["broker_symbol"],
            "n_positions": len(lst),
        }

    # Tous les tickers a comparer = union Thesium ∪ broker
    all_tickers = set(thesium_positions.keys()) | set(broker_agg_by_thesium.keys())

    for tk in sorted(all_tickers):
        th = thesium_positions.get(tk)
        br = broker_agg_by_thesium.get(tk)
        map_info = mapping_by_thesium.get(tk)
        broker_sym = (map_info["broker_symbol"] if map_info
                      else (br["broker_symbol"] if br else None))

        qty_th = th["qty"] if th else None
        qty_br = br["qty"] if br else None

        # Notional Thesium = qty * last_price (best effort)
        notional_th = (abs(qty_th) * th["last_price"]
                       if (th and th.get("last_price")) else None)
        notional_br = br["notional_usd"] if br else None

        # Drift calculs
        qty_drift = None
        qty_drift_pct = None
        notional_drift = None
        if qty_th is not None and qty_br is not None:
            qty_drift = qty_th - qty_br
            denom = max(abs(qty_th), abs(qty_br), 1e-9)
            qty_drift_pct = abs(qty_drift) / denom
        if notional_th is not None and notional_br is not None:
            notional_drift = notional_th - notional_br

        # Status
        if qty_th is None and qty_br is not None:
            status = "broker_only"
        elif qty_br is None and qty_th is not None:
            status = "thesium_only"
        elif (qty_drift_pct is not None and qty_drift_pct <= DRIFT_TOL_PCT):
            status = "match"
        else:
            status = "drift_qty"

        rows.append({
            "thesium_ticker": tk,
            "broker_symbol": broker_sym,
            "qty_thesium": qty_th,
            "qty_broker": qty_br,
            "qty_drift": qty_drift,
            "qty_drift_pct": qty_drift_pct,
            "notional_thesium_usd": notional_th,
            "notional_broker_usd": notional_br,
            "notional_drift_usd": notional_drift,
            "status": status,
            "details": {
                "n_broker_positions": br["n_positions"] if br else 0,
                "thesium_avg_price": th["avg_price"] if th else None,
                "thesium_last_price": th["last_price"] if th else None,
            },
        })

    return rows


# ----------------------------- 6 -----------------------------
def insert_run_and_log(con, source, status, account_info, rows, notes=""):
    """Insert un run + toutes ses lignes log. Retourne run_id."""
    ts = now_iso()
    n_thesium = sum(1 for r in rows if r["qty_thesium"] is not None)
    n_broker = sum(1 for r in rows if r["qty_broker"] is not None)
    n_matched = sum(1 for r in rows if r["status"] == "match")
    n_drifts = sum(1 for r in rows if r["status"] == "drift_qty")
    n_thes_only = sum(1 for r in rows if r["status"] == "thesium_only")
    n_brok_only = sum(1 for r in rows if r["status"] in ("broker_only", "unmapped"))

    account_id = None
    balance = None
    equity = None
    if account_info:
        account_id = str(account_info.get("login", ""))
        balance = account_info.get("balance")
        equity = account_info.get("equity")

    cur = con.cursor()
    cur.execute("""
        INSERT INTO broker_reconciliation_runs
            (ts, source, status, n_thesium, n_broker, n_matched,
             n_drifts_qty, n_thesium_only, n_broker_only,
             account_id, balance, equity, notes)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (ts, source, status, n_thesium, n_broker, n_matched,
          n_drifts, n_thes_only, n_brok_only,
          account_id, balance, equity, notes))
    run_id = cur.lastrowid

    for r in rows:
        cur.execute("""
            INSERT INTO broker_reconciliation_log
                (run_id, ts, thesium_ticker, broker_symbol,
                 qty_thesium, qty_broker, qty_drift, qty_drift_pct,
                 notional_thesium_usd, notional_broker_usd, notional_drift_usd,
                 status, details_json)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (run_id, ts, r["thesium_ticker"], r["broker_symbol"],
              r["qty_thesium"], r["qty_broker"], r["qty_drift"], r["qty_drift_pct"],
              r["notional_thesium_usd"], r["notional_broker_usd"],
              r["notional_drift_usd"], r["status"],
              json.dumps(r["details"], default=str)))

    con.commit()
    return run_id, n_thesium, n_broker, n_matched, n_drifts, n_thes_only, n_brok_only


# ----------------------------- main -----------------------------
def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--source", default="metaapi_live",
                    choices=["metaapi_live", "shadow_only"])
    ap.add_argument("--no-broker", action="store_true",
                    help="ignore MetaAPI (utile en marche ferme)")
    ap.add_argument("--verbose", action="store_true")
    args = ap.parse_args()

    if args.no_broker:
        args.source = "shadow_only"

    banner(f"[1] Reconciliation broker - source={args.source}")
    con = open_db()

    # Charge mappings (toujours)
    print(f"  {len(mapping_by_broker)} mappings instrument_broker_mapping")

    # Positions Thesium
    thesium_positions = fetch_thesium_positions(con)
    mapping_by_broker, mapping_by_thesium = fetch_mappings(con, thesium_tickers=list(thesium_positions.keys()))
    print(f"  {len(thesium_positions)} positions Thesium (qty != 0)")
    if args.verbose:
        for tk, info in list(thesium_positions.items())[:10]:
            print(f"    {tk:8} qty={info['qty']:>12.4f}  "
                  f"last={info['last_price']}")

    # Positions broker
    broker_positions_raw = []
    account_info = None
    status = "ok"
    notes_parts = []

    if args.source == "metaapi_live":
        banner("[2] Fetch positions ActivTrades (MetaAPI)")
        positions, err = fetch_broker_positions(verbose=args.verbose)
        if err:
            status = "error" if "missing" in err else "partial"
            notes_parts.append(f"broker_err={err}")
            broker_positions_raw = []
        else:
            broker_positions_raw = positions or []
        print(f"  {len(broker_positions_raw)} positions broker ActivTrades")

        # Account info pour la run
        try:
            import metaapi_provider as mp
            if mp.is_configured():
                account_info = mp.get_account_information()
                if account_info and args.verbose:
                    print(f"  account : login={account_info.get('login')} "
                          f"balance={account_info.get('balance')} "
                          f"equity={account_info.get('equity')}")
        except Exception as e:
            notes_parts.append(f"acct_info_err={e}")
    else:
        banner("[2] Source shadow_only -> on saute le fetch broker")
        broker_positions_raw = []

    # Normalisation broker positions
    broker_positions_norm = [
        normalize_broker_position(p, mapping_by_broker)
        for p in broker_positions_raw
        if isinstance(p, dict)
    ]
    if args.verbose and broker_positions_norm:
        print(f"  {len(broker_positions_norm)} positions broker normalisees :")
        for bp in broker_positions_norm[:10]:
            print(f"    {bp['broker_symbol']:12} -> {bp['thesium_ticker']:8} "
                  f"qty_units={bp['qty_units_signed']:.4f}  "
                  f"notional={bp['notional_usd']}")

    # Reconciliation
    banner("[3] Reconciliation")
    try:
        rows = reconcile(thesium_positions, broker_positions_norm,
                         mapping_by_broker, mapping_by_thesium)
    except Exception as e:
        print(f"[FAIL] reconcile : {e}")
        traceback.print_exc()
        status = "error"
        rows = []

    # Insertion
    banner("[4] Insertion log")
    notes = "; ".join(notes_parts) if notes_parts else ""
    try:
        run_id, n_thes, n_brok, n_match, n_drift, n_thes_only, n_brok_only = \
            insert_run_and_log(con, args.source, status, account_info, rows, notes)
    except Exception as e:
        print(f"[FAIL] insertion : {e}")
        traceback.print_exc()
        con.close()
        sys.exit(1)

    banner("[5] Resume")
    print(f"  run_id        : {run_id}")
    print(f"  status        : {status}")
    print(f"  thesium       : {n_thes}")
    print(f"  broker        : {n_brok}")
    print(f"  matched       : {n_match}")
    print(f"  drift_qty     : {n_drift}")
    print(f"  thesium_only  : {n_thes_only}")
    print(f"  broker_only   : {n_brok_only}")
    print(f"  notes         : {notes or '(none)'}")

    if args.verbose:
        banner("[6] Detail (top 20)")
        for r in rows[:20]:
            tk = r["thesium_ticker"] or "?"
            bs = r["broker_symbol"] or "?"
            print(f"  {tk:8} <-> {bs:12} : "
                  f"thes={r['qty_thesium']} brok={r['qty_broker']} "
                  f"drift_pct={r['qty_drift_pct']} {r['status']}")

    con.close()
    sys.exit(0 if status == "ok" else (1 if status == "error" else 0))


if __name__ == "__main__":
    main()
