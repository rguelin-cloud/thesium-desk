    end_date: str = ""

@app.post("/api/backtest/export-csv")
def export_backtest_csv(req: ExportCsvRequest):
    """Generate CSV from trade journal data."""
    import io
    if not req.trade_journal:
        raise HTTPException(status_code=400, detail="Aucun journal de trading fourni")

    sep = ';'
    buf = io.StringIO()

    # BOM for Excel UTF-8
    buf.write('\ufeff')

    # Header
    headers = ['Date', 'Ticker', 'Poids (%)', 'Prix', 'Rendement Jour (%)', 'Rendement Cumul (%)', 'Valeur Position']
    buf.write(sep.join(headers) + '\n')

    # Sort by date then ticker
    sorted_journal = sorted(req.trade_journal, key=lambda r: (r.get('date', ''), r.get('ticker', '')))

    for row in sorted_journal:
        buf.write(sep.join([
            str(row.get('date', '')),
            str(row.get('ticker', '')),
            str(row.get('poids_pct', '')),
            str(row.get('prix', '')),
            str(row.get('rendement_jour_pct', '')),
            str(row.get('rendement_cumul_pct', '')),
            str(row.get('valeur_position', '')),
        ]) + '\n')

    # Summary section
    s = req.stats
    buf.write('\n')
    buf.write('Statistiques Portfolio\n')
    buf.write(f'Rendement Total (%){sep}{s.get("total_return_pct", "")}\n')
    buf.write(f'Rendement Annualis\u00e9 (%){sep}{s.get("annualized_return_pct", "")}\n')
    buf.write(f'Volatilit\u00e9 (%){sep}{s.get("volatility_pct", "")}\n')
    buf.write(f'Sharpe{sep}{s.get("sharpe", "")}\n')
    buf.write(f'Sortino{sep}{s.get("sortino", "")}\n')
    buf.write(f'Max Drawdown (%){sep}{s.get("max_drawdown_pct", "")}\n')
    buf.write(f'Win Rate (%){sep}{s.get("win_rate_pct", "")}\n')
    buf.write(f'P\u00e9riode{sep}{req.start_date} \u2192 {req.end_date}\n')
    buf.write(f'Jours de trading{sep}{s.get("trading_days", "")}\n')
    buf.write(f'Valeur finale{sep}{s.get("final_value", "")}\n')

    csv_content = buf.getvalue()
    buf.close()

    safe_start = req.start_date.replace('/', '-')
    safe_end = req.end_date.replace('/', '-')

    from starlette.responses import Response
    return Response(
        content=csv_content.encode('utf-8-sig'),
        media_type='text/csv',
        headers={
            'Content-Disposition': f'attachment; filename="backtest_journal_{safe_start}_{safe_end}.csv"',
        },
    )


