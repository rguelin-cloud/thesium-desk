def run_backtest_endpoint(request: Request, req: BacktestRequest):
    """Run portfolio backtest on selected tickers."""
    conn = db()
    try:
        # Build ticker list
        tickers = list(req.tickers)

        # If no explicit tickers, use instruments from DB
        if not tickers:
            query_parts = []
            params = []
            if req.include_equity:
                query_parts.append("asset_class IN ('equity', 'etf')")
            if req.include_crypto:
                query_parts.append("asset_class = 'crypto'")
            if not query_parts:
                query_parts.append("asset_class = 'equity'")

            where = " OR ".join(query_parts)
            rows = conn.execute(
                f"SELECT ticker, asset_class FROM instruments WHERE {where}"
            ).fetchall()
            tickers = [r["ticker"] for r in rows]

        # Build asset_class mapping
        all_instruments = conn.execute(
            "SELECT ticker, asset_class FROM instruments"
        ).fetchall()
        asset_classes = {r["ticker"]: r["asset_class"] for r in all_instruments}
        # For tickers not in DB, assume equity
        for t in tickers:
            if t not in asset_classes:
                asset_classes[t] = "equity"

        # Remove benchmark from portfolio tickers if present
        if req.benchmark in tickers:
            tickers.remove(req.benchmark)

        result = backtest_engine.run_backtest(
            tickers=tickers,
            asset_classes=asset_classes,
            weights=req.custom_weights,
            months=req.months,
            initial_capital=req.initial_capital,
            benchmark=req.benchmark,
        )

        return _sanitize_for_json(result)
