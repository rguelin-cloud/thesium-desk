"""
data_ingestion.py - Yahoo Finance data fetching for Thesium.finance
Fetches OHLCV price data using Yahoo Finance's free public API.
No API key required.
"""
import json
import sqlite3
import urllib.request
import urllib.parse
from datetime import datetime, timedelta
from models import get_db, log_event, init_db


YAHOO_BASE = "https://query1.finance.yahoo.com/v8/finance/chart/"


def fetch_yahoo_prices(ticker: str, period: str = "1mo", interval: str = "1d") -> list[dict]:
    """
    Fetch OHLCV data from Yahoo Finance for a single ticker.
    Returns a list of dicts: {date, open, high, low, close, volume}
    """
    url = f"{YAHOO_BASE}{urllib.parse.quote(ticker)}?range={period}&interval={interval}"
    headers = {
        "User-Agent": "Mozilla/5.0 (compatible; Thesium/1.0)",
        "Accept": "application/json",
    }
    req = urllib.request.Request(url, headers=headers)

    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode())
    except Exception as e:
        print(f"[data_ingestion] Failed to fetch {ticker}: {e}")
        return []

    try:
        chart = data["chart"]["result"][0]
        timestamps = chart["timestamp"]
        ohlcv = chart["indicators"]["quote"][0]

        rows = []
        for i, ts in enumerate(timestamps):
            dt = datetime.utcfromtimestamp(ts).strftime("%Y-%m-%d")
            close = ohlcv["close"][i]
            if close is None:
                continue
            rows.append({
                "date":   dt,
                "open":   ohlcv["open"][i]   or close,
                "high":   ohlcv["high"][i]   or close,
                "low":    ohlcv["low"][i]    or close,
                "close":  close,
                "volume": ohlcv["volume"][i] or 0,
            })
        return rows
    except (KeyError, IndexError, TypeError) as e:
        print(f"[data_ingestion] Parse error for {ticker}: {e}")
        return []


def upsert_prices(conn: sqlite3.Connection, instrument_id: int, rows: list[dict]):
    """Insert or replace price rows for an instrument."""
    for row in rows:
        conn.execute(
            """INSERT OR REPLACE INTO prices (instrument_id, date, open, high, low, close, volume)
               VALUES (?, ?, ?, ?, ?, ?, ?)""",
            (instrument_id, row["date"], row["open"], row["high"],
             row["low"], row["close"], row["volume"])
        )


def run_ingestion(tickers: list[str] = None, period: str = "1mo") -> dict:
    """
    Main ingestion entry point. Fetches prices for all instruments (or given tickers)
    and stores them in the database.
    """
    conn = get_db()
    try:
        # Get instruments to ingest
        if tickers:
            placeholders = ",".join("?" * len(tickers))
            instruments = conn.execute(
                f"SELECT id, ticker, asset_class FROM instruments WHERE ticker IN ({placeholders})", tickers
            ).fetchall()
        else:
            instruments = conn.execute("SELECT id, ticker, asset_class FROM instruments").fetchall()

        results = {"fetched": 0, "failed": [], "updated_tickers": []}
        for inst in instruments:
            # Crypto tickers need -USD suffix for Yahoo Finance
            yahoo_ticker = inst["ticker"]
            if inst["asset_class"] == "crypto":
                yahoo_ticker = f"{inst['ticker']}-USD"
            rows = fetch_yahoo_prices(yahoo_ticker, period=period)
            if rows:
                upsert_prices(conn, inst["id"], rows)
                results["fetched"] += len(rows)
                results["updated_tickers"].append(inst["ticker"])
            else:
                results["failed"].append(inst["ticker"])

        conn.commit()
        log_event(conn, "data_ingestion_complete", details={
            "tickers_updated": results["updated_tickers"],
            "rows_fetched": results["fetched"],
            "failed": results["failed"],
        }, agent="DataIngestion")
        conn.commit()
        return results
    finally:
        conn.close()


if __name__ == "__main__":
    init_db()
    results = run_ingestion()
    print(f"Ingestion complete: {results}")
