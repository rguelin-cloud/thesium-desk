def run_decision_cycle(conn: sqlite3.Connection) -> dict:
    """
    Decision cycle PATCHED 2026-05-22 + 2026-05-24 :
      - conviction >= 5
      - FactorAgent overweight  â†’ BUY (toujours)
      - FactorAgent underweight â†’ SELL UNIQUEMENT si position dÃ©tenue
      - MicrostructureAgent sell signal â†’ SELL UNIQUEMENT si position dÃ©tenue
      - CryptoAgent strong_buy/buy/accumulate â†’ BUY ; sell/take_profit â†’ SELL si tenu
      - OrderReconciler : dÃ©duplique conflits, drop bruit < 0,3 % NAV,
        bypass conviction >= 9
    """
    from agents import run_all_agents
    from memo_generator import generate_ic_memo

    print("[execution] Starting decision cycle...")

    # Step 1: Run agents
    agent_results = run_all_agents(conn)
    conn.commit()

    proposals = []

    # ----- FactorAgent -----
    for item in agent_results.get("factor", []):
        conv   = item.get("conviction", 0)
        tilt   = item.get("tilt")
        ticker = item.get("ticker")
        if conv < CONVICTION_THRESHOLD:
            continue

        if tilt == "overweight":
            proposals.append({
                "thesis_id": item["thesis_id"], "ticker": ticker,
                "side": "buy", "quantity_pct": FACTOR_POSITION_PCT,
                "source": "FactorAgent",
                "conviction": conv,
            })
        elif tilt == "underweight":
            held_qty = get_position_qty(conn, ticker)
            if held_qty > 0:
                proposals.append({
                    "thesis_id": item["thesis_id"], "ticker": ticker,
                    "side": "sell", "quantity_pct": FACTOR_POSITION_PCT,
                    "source": "FactorAgent",
                    "max_qty": held_qty,
                    "conviction": conv,
                })
            else:
                print(f"[execution] Skip SELL {ticker}: no position held (underweight thesis ignored)")

    # ----- MicrostructureAgent -----
    for item in agent_results.get("microstructure", []):
        conv   = item.get("conviction", 0)
        signal = item.get("signal", "").lower()
        ticker = item.get("ticker")
        if conv < CONVICTION_THRESHOLD:
            continue

        if "buy" in signal:
            proposals.append({
                "thesis_id": item["thesis_id"], "ticker": ticker,
                "side": "buy", "quantity_pct": MICRO_POSITION_PCT,
                "source": "MicrostructureAgent",
                "conviction": conv,
            })
        elif "sell" in signal or "reduce" in signal:
            held_qty = get_position_qty(conn, ticker)
            if held_qty > 0:
                proposals.append({
                    "thesis_id": item["thesis_id"], "ticker": ticker,
                    "side": "sell", "quantity_pct": MICRO_POSITION_PCT,
                    "source": "MicrostructureAgent",
                    "max_qty": held_qty,
                    "conviction": conv,
                })
            else:
                print(f"[execution] Skip SELL {ticker}: no position held (micro signal ignored)")

    # ----- CryptoAgent -----
    for item in agent_results.get("crypto", []):
        conv   = item.get("conviction", 0)
        signal = item.get("signal", "").lower()
        ticker = item.get("ticker")
        if conv < CONVICTION_THRESHOLD:
            continue

        if signal in ("strong_buy", "buy", "accumulate"):
            qty_pct = MICRO_POSITION_PCT * 2 if signal == "strong_buy" else MICRO_POSITION_PCT
            proposals.append({
                "thesis_id": item["thesis_id"], "ticker": ticker,
                "side": "buy", "quantity_pct": qty_pct,
                "source": "CryptoAgent",
                "conviction": conv,
            })
        elif signal in ("sell", "take_profit"):
            held_qty = get_position_qty(conn, ticker)
            if held_qty > 0:
                proposals.append({
                    "thesis_id": item["thesis_id"], "ticker": ticker,
                    "side": "sell", "quantity_pct": MICRO_POSITION_PCT,
                    "source": "CryptoAgent",
                    "max_qty": held_qty,
                    "conviction": conv,
                })
            else:
                print(f"[execution] Skip SELL {ticker}: no position held (crypto signal ignored)")

    # Step 2 : Compute NAV
    portfolio_state = conn.execute(
        "SELECT total_value, cash FROM portfolio_state WHERE id = 1"
    ).fetchone()
    total_value = portfolio_state["total_value"] if portfolio_state else 1_000_000

    # cycle_id partagÃ© par ExitAgent, PortfolioRegime et Reconciler
    cycle_id = datetime.utcnow().strftime("%Y%m%d-%H%M%S")

    # ============================================================
    # Step 2.3 : DÃ‰TECTION DU RÃ‰GIME DE PORTEFEUILLE (NEW â€” v6)
    # ============================================================
    # Calcule BUILD / MAINTAIN / REBALANCE selon % investi du NAV.
    # Sera appliquÃ© aprÃ¨s l'ExitAgent (pour attÃ©nuer les exit proposals)
    # et avant le Reconciler.
    try:
        regime_info = detect_portfolio_regime(conn)
        print(f"[regime] RÃ©gime dÃ©tectÃ© : {regime_info['regime']} "
              f"(invested={regime_info['invested_pct']:.2f} %, "
              f"NAV={regime_info['nav']:.0f}, cash={regime_info['cash']:.0f}, "
              f"positions={regime_info['n_positions']})")
    except Exception as e:
        import traceback
        print(f"[regime] ERREUR dÃ©tection â€” fallback MAINTAIN : {e}")
        traceback.print_exc()
        regime_info = {"regime": "MAINTAIN", "invested_pct": 50.0,
                       "nav": total_value, "cash": 0.0, "n_positions": 0}

    # ============================================================
    # Step 2.4 : EXIT AGENT (patch 2026-05-24 b / v5)
    # ============================================================
    # Examine les positions ouvertes et Ã©met SL / TP / DRIFT / TIME_DECAY.
    # En rÃ©gime BUILD, les exit proposals seront attÃ©nuÃ©s par le mult Ã—0.3
    # appliquÃ© au Step 2.45.
    try:
        targets_cache = _load_target_weights(conn)
        exit_proposals = run_exit_agent(
            conn, cycle_id=cycle_id,
            targets=targets_cache, nav=total_value
        )
        if exit_proposals:
            print(f"[execution] ExitAgent : {len(exit_proposals)} signal(s) ajoutÃ©(s)")
            proposals.extend(exit_proposals)
    except Exception as e:
        import traceback
        print(f"[exit_agent] ERREUR (non bloquant) : {e}")
        traceback.print_exc()

    # ============================================================
    # Step 2.42 : TARGET GAP SYNTHESIZER (NEW â€” v6.4)
    # ============================================================
    # Lit portfolio_targets et gÃ©nÃ¨re des propositions synthÃ©tiques pour
    # combler tout Ã©cart > 0.30 % NAV avec les positions actuelles.
    # Doit tourner APRÃˆS les agents (pour pouvoir fusionner avec leurs
    # propositions) et AVANT le rÃ©gime (pour bÃ©nÃ©ficier des caps).
    try:
        gap_synth, _, gap_stats = _build_target_gap_proposals(
            conn, total_value, proposals,
            regime=regime_info.get("regime", "MAINTAIN"),
        )
        if gap_synth:
            proposals.extend(gap_synth)
        print(
            f"[target_gap] {gap_stats['n_buy_inj']} BUY synthÃ©tiques, "
            f"{gap_stats['n_sell_inj']} SELL synthÃ©tiques, "
            f"{gap_stats['n_merged']} fusions avec agents, "
            f"{gap_stats['n_skipped_small']} Ã©cart(s) sous le seuil 0.30 % â€” "
            f"gap total |Î”|={gap_stats['gap_total_pct']:.2f} % â€” "
            f"{gap_stats['n_conflict_resolved']} conflit(s) BUY/SELL rÃ©solu(s) [v6.5]"
        )
    except Exception as e:
        import traceback
        print(f"[target_gap] ERREUR (non bloquant) : {e}")
        traceback.print_exc()

    # ============================================================
    # Step 2.45 : APPLICATION DU RÃ‰GIME (NEW â€” v6)
    # ============================================================
    # 1) Enrichit chaque proposal avec sa conviction brute (depuis agent_results)
    # 2) Applique le multiplicateur (rÃ©gime Ã— agent_type) sur la conviction
    # 3) Plafonne la taille des SELL en % de la position dÃ©tenue
    # 4) Plafonne la taille des BUY au target Ã— overshoot
    # 5) Log dans regime_log
    try:
        proposals = _enrich_proposals_with_conviction(proposals, agent_results)
        targets_for_regime = _load_target_weights(conn) or {}
        regime_stats = apply_regime_to_proposals(
            conn, proposals, regime_info, target_weights=targets_for_regime
        )
        log_regime(conn, cycle_id, regime_info, regime_stats,
                   notes=f"v6 â€” {regime_stats['n_attenuated']} att., "
                         f"{regime_stats['n_sell_capped']} SELL capped, "
                         f"{regime_stats['n_buy_capped']} BUY capped")
        if regime_stats["n_sell_capped"] or regime_stats["n_buy_capped"] \
           or regime_stats["n_attenuated"]:
            print(f"[regime] {regime_info['regime']} appliquÃ© : "
                  f"{regime_stats['n_attenuated']} convictions ajustÃ©es, "
                  f"{regime_stats['n_sell_capped']} SELL plafonnÃ©s, "
                  f"{regime_stats['n_buy_capped']} BUY plafonnÃ©s")
            # Trace dÃ©taillÃ©e des proposals modifiÃ©s
            for p in proposals:
                if p.get("cap_reason"):
                    print(f"[regime]   {p.get('ticker')} {p.get('side','').upper()}"
                          f" â€” {p['cap_reason']}")
                if abs(float(p.get("regime_mult", 1.0)) - 1.0) > 1e-9:
                    print(f"[regime]   {p.get('ticker')} {p.get('side','').upper()}"
                          f" {p.get('agent_type','?')} : conv "
                          f"{p.get('conviction_raw',0):.1f} Ã— {p.get('regime_mult'):.2f}"
                          f" = {p.get('conviction',0):.2f}")
    except Exception as e:
        import traceback
        print(f"[regime] ERREUR application (non bloquant) : {e}")
        traceback.print_exc()

    # ============================================================
    # Step 2.5 : RECONCILIATION (patch 2026-05-24 a)
    # ============================================================
    proposals_before = len(proposals)
    try:
        # _enrich_proposals_with_conviction est idempotent â€” dÃ©jÃ  appelÃ© en 2.45
        # mais on le rappelle au cas oÃ¹ des proposals auraient Ã©tÃ© ajoutÃ©s ailleurs
        proposals = _enrich_proposals_with_conviction(proposals, agent_results)
        current_pos, prices_map, target_weights = _build_reconciler_context(
            conn, total_value, proposals
        )

        reconciler = OrderReconciler(
            conn=conn,
            nav=total_value,
            current_positions=current_pos,
            target_weights=target_weights,
            prices=prices_map,
            regime=regime_info.get("regime", "MAINTAIN"),  # v6.1 : Reconciler rÃ©gime-aware
        )
        proposals = reconciler.reconcile(proposals, cycle_id=cycle_id)
        print(
            f"[reconciler] {proposals_before} proposals â†’ {len(proposals)} aprÃ¨s rÃ©conciliation"
            f" (cycle_id={cycle_id})"
        )
    except Exception as e:
        import traceback
        print(f"[reconciler] ERREUR : {e} â€” fallback : proposals inchangÃ©es")
        traceback.print_exc()
    # ============================================================

    # Step 3 & 4 : create pending orders
    _ = cycle_id  # cycle_id dÃ©jÃ  dÃ©fini plus haut (Step 2)
    pending_orders = []
    for proposal in proposals:
        inst = conn.execute(
            "SELECT id FROM instruments WHERE ticker = ?", (proposal["ticker"],)
        ).fetchone()
        if not inst:
            continue

        price_row = conn.execute(
            "SELECT close FROM prices WHERE instrument_id = ? ORDER BY date DESC LIMIT 1",
            (inst["id"],)
        ).fetchone()
        if not price_row:
            continue

        price = price_row[0]
        target_value = total_value * (proposal["quantity_pct"] / 100)
        # [RDC_CRYPTO_V1] crypto-aware quantity computation
        _rdc_crypto_set = {'BTC','ETH','LINK','SOL','ADA','DOT','MATIC','AVAX'}
        _rdc_ticker = str(proposal.get("ticker","")).upper()
        _rdc_is_crypto = _rdc_ticker in _rdc_crypto_set
        if _rdc_is_crypto:
            quantity = round(target_value / price, 6)
        else:
            quantity = math.floor(target_value / price)
        # FIX : pour les SELL, plafonner Ã  la position dÃ©tenue
        if proposal["side"] == "sell" and "max_qty" in proposal:
            quantity = int(min(quantity, math.floor(proposal["max_qty"])))

        # [BUILD_QTY1_V1] override BUILD : equities BUY force a qty=1 par cycle si >= 1
        try:
            _bq1_regime = str(proposal.get("regime", "")).upper()
            if not _bq1_regime:
                # fallback : recalc invested_pct
                _bq1_inv_pct = 0.0
                try:
                    _bq1_inv_pct = float(conn.execute(
                        "SELECT COALESCE(SUM(quantity * avg_price),0)/NULLIF(?,0)*100 FROM portfolio_positions",
                        (total_value,)
                    ).fetchone()[0] or 0.0)
                except Exception:
                    pass
                _bq1_regime = "BUILD" if _bq1_inv_pct < 20.0 else "MAINTAIN"
            _bq1_is_build = (_bq1_regime == "BUILD")
            _bq1_is_buy = (str(proposal.get("side", "")).lower() == "buy")
            if _bq1_is_build and _bq1_is_buy and not _rdc_is_crypto:
                if quantity >= 1:
                    print(f"[BUILD_QTY1_V1] {_rdc_ticker} : qty {quantity} -> 1 (BUILD equity override)")
                    quantity = 1
                else:
                    print(f"[BUILD_QTY1_V1] {_rdc_ticker} : qty {quantity} < 1 -> SKIP")
                    continue
        except Exception as _bq1_e:
            print(f"[BUILD_QTY1_V1] error : {_bq1_e}")
        # [RDC_CRYPTO_V1] tolerate crypto fractional positions
        _rdc_min_qty = 0.0001 if _rdc_is_crypto else 0
        if quantity <= _rdc_min_qty:
            continue
        # v6.4 â€” si la proposition est synthÃ©tique (TargetGap), crÃ©er une
        # thÃ¨se PortfolioConstructionAgent pour garder un audit propre
        if proposal.get("thesis_id") is None and proposal.get("source") == "TargetGap":
            synth_thesis_id = conn.execute("""
                INSERT INTO theses
                  (instrument_id, agent_type, thesis_text, conviction_score,
