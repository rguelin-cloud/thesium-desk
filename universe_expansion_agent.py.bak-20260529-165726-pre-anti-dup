# Scoring
# ---------------------------------------------------------------------------
def _safe_clip(x: float, lo: float, hi: float) -> float:
    if math.isnan(x):
        return 0.0
    return max(lo, min(hi, x))


def _normalize_features(features: list[Features]) -> None:
    """Normalise les features sur [0,1] par rang (robuste outliers)."""
    if not features:
        return
    df = pd.DataFrame([{
        "i": i,
        "mom": f.momentum_12m_minus_1m,
        "sharpe": f.sharpe_90d,
        "trend": f.trend_strength_r2,
        "vol_g": f.volume_growth_3m,
    } for i, f in enumerate(features)])

    def rank_norm(col: str) -> pd.Series:
        s = df[col]
        if s.isna().all():
            return pd.Series([0.5] * len(s), index=s.index)
        ranks = s.rank(method="average", na_option="bottom")
        n = ranks.max()
        if n <= 1:
            return pd.Series([0.5] * len(s), index=s.index)
        return (ranks - 1) / (n - 1)

    nm = rank_norm("mom")
    nsh = rank_norm("sharpe")
    ntr = rank_norm("trend")
    nvg = rank_norm("vol_g")

    for idx, f in enumerate(features):
        score = (
            W_MOMENTUM * float(nm.iloc[idx])
            + W_SHARPE * float(nsh.iloc[idx])
            + W_TREND * float(ntr.iloc[idx])
            + W_VOLUME * float(nvg.iloc[idx])
        )
        f.score = round(score, 4)
        if score > 0.8:
            f.suggested_cap_pct = CAP_HIGH_SCORE
        elif score >= 0.5:
            f.suggested_cap_pct = CAP_MID_SCORE
        else:
            f.suggested_cap_pct = CAP_LOW_SCORE


# ---------------------------------------------------------------------------
# Correlation vs portefeuille existant
# ---------------------------------------------------------------------------
def compute_max_correl(
    candidate_prices: pd.Series,
    portfolio_returns: pd.DataFrame,
) -> tuple[float, str | None]:
    if portfolio_returns.empty:
        return float("nan"), None
    rets = candidate_prices.pct_change().dropna()
    rets.index = pd.to_datetime(rets.index).normalize()
    common = rets.index.intersection(portfolio_returns.index)
    if len(common) < 30:
        return float("nan"), None
    r = rets.loc[common]
    p = portfolio_returns.loc[common]
    correls = {}
    for col in p.columns:
        v = p[col].dropna()
        idx = v.index.intersection(r.index)
        if len(idx) < 30:
            continue
        c = float(np.corrcoef(r.loc[idx].values, v.loc[idx].values)[0, 1])
        if not math.isnan(c):
            correls[col] = c
    if not correls:
        return float("nan"), None
    sym, val = max(correls.items(), key=lambda kv: abs(kv[1]))
    return float(val), sym


# ---------------------------------------------------------------------------
# Rationale via Perplexity
# ---------------------------------------------------------------------------
def build_rationale(features: Features) -> tuple[str, str]:
    """4-5 lignes via PerplexityClient. Fallback texte deterministe."""
    if PerplexityClient is None:
        return _deterministic_rationale(features), "deterministic"

    try:
        client = PerplexityClient()
        prompt = (
            f"Tu es un analyste quantitatif. En 4 a 5 lignes maximum, francais sobre, "
            f"explique pourquoi {features.ticker} ({features.name or features.asset_class}) "
            f"merite d'etre ajoute a un portefeuille discretionnaire en {datetime.now().year}. "
            f"Indicateurs : momentum 12m-1m = {features.momentum_12m_minus_1m:+.1%}, "
            f"sharpe 90j = {features.sharpe_90d:.2f}, trend R2 = {features.trend_strength_r2:.2f}, "
            f"volatilite annualisee = {features.realized_vol_90d:.1%}. "
            f"Mentionne 1 catalyseur fondamental court et 1 risque. Ne donne pas d'objectif de prix."
        )
        resp = client.ask(prompt, model="sonar", max_tokens=350)
        text = (resp or {}).get("content") or ""
        if text.strip():
            return text.strip(), "perplexity"
    except Exception as exc:
        log.warning("Perplexity rationale failed for %s: %s", features.ticker, exc)
    return _deterministic_rationale(features), "deterministic_fallback"


def _deterministic_rationale(f: Features) -> str:
    parts = [
        f"{f.ticker} ({f.name or f.asset_class}) presente un score composite de {f.score:.2f}.",
        f"Momentum 12m-1m {f.momentum_12m_minus_1m:+.1%}, sharpe 90j {f.sharpe_90d:.2f}, trend R2 {f.trend_strength_r2:.2f}.",
        f"Volatilite annualisee 90j a {f.realized_vol_90d:.1%}, correlation max au portefeuille "
        f"{('NA' if math.isnan(f.max_correl_existing) else f'{f.max_correl_existing:+.2f} ({f.max_correl_with})')}.",
        f"Cap suggere : {f.suggested_cap_pct:.0%}. Rationale generee localement (Perplexity indisponible).",
    ]
    return " ".join(parts)


