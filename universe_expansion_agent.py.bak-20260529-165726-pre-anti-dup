def approve_candidate(candidate_id: int, reviewed_by: str, max_weight_pct: float | None = None) -> dict[str, Any]:
    """Approuve un candidat :
       1. status = 'approved'
       2. Insert dans instruments si absent
       3. Insert dans target_universe (is_active=1, max_weight_pct = suggested_cap_pct sauf override)
    """
    conn = _conn()
    try:
        cur = conn.execute(
            "SELECT * FROM universe_candidates WHERE id = ? AND status = 'pending';",
            (candidate_id,),
        )
        cand = cur.fetchone()
        if not cand:
            return {"ok": False, "error": "candidate_not_found_or_not_pending"}

        ticker = cand["ticker"]
        cap = max_weight_pct if max_weight_pct is not None else (cand["suggested_cap_pct"] or 0.02)

        # 1) instruments
        cur2 = conn.execute("SELECT id FROM instruments WHERE ticker = ?;", (ticker,))
        instr = cur2.fetchone()
        if not instr:
            conn.execute(
                """INSERT INTO instruments (ticker, name, sector, asset_class)
                   VALUES (?, ?, ?, ?);""",
                (ticker, cand["name"] or ticker, cand["sector"] or "Other", cand["asset_class"]),
            )

        # 2) target_universe
        cur3 = conn.execute("SELECT id FROM target_universe WHERE ticker = ?;", (ticker,))
        tu = cur3.fetchone()
        if not tu:
            conn.execute(
                """INSERT INTO target_universe
                   (ticker, asset_class, sector, is_active, max_weight_pct, min_weight_pct, added_at)
                   VALUES (?, ?, ?, 1, ?, 0.5, datetime('now'));""",
                (ticker, cand["asset_class"], cand["sector"] or "Other", cap * 100.0),
            )
        else:
            conn.execute(
                "UPDATE target_universe SET is_active = 1, max_weight_pct = ? WHERE ticker = ?;",
                (cap * 100.0, ticker),
            )

        # 3) candidate
        conn.execute(
            """UPDATE universe_candidates
               SET status = 'approved', reviewed_by = ?, reviewed_at = datetime('now')
               WHERE id = ?;""",
            (reviewed_by, candidate_id),
        )
        conn.commit()
        return {"ok": True, "ticker": ticker, "max_weight_pct": cap}
    finally:
        conn.close()


def reject_candidate(candidate_id: int, reviewed_by: str, notes: str | None = None) -> dict[str, Any]:
    conn = _conn()
    try:
        conn.execute(
            """UPDATE universe_candidates
               SET status = 'rejected', reviewed_by = ?, reviewed_at = datetime('now'), notes = ?
               WHERE id = ? AND status = 'pending';""",
            (reviewed_by, notes or "", candidate_id),
        )
        n = conn.total_changes
        conn.commit()
        return {"ok": n > 0, "updated": n}
    finally:
        conn.close()


