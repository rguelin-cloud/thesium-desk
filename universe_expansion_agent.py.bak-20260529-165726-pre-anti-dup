@dataclass
class Features:
    ticker: str
    asset_class: str
    sector: str | None
    name: str | None
    momentum_12m_minus_1m: float = float("nan")
    momentum_3m: float = float("nan")
    realized_vol_90d: float = float("nan")
    sharpe_90d: float = float("nan")
    trend_strength_r2: float = float("nan")
    volume_growth_3m: float = float("nan")
    volume_usd_30d_avg: float = float("nan")
    max_correl_existing: float = float("nan")
    max_correl_with: str | None = None
    score: float = float("nan")
    suggested_cap_pct: float = float("nan")
    rationale: str = ""
    rationale_source: str = ""
    extra: dict[str, Any] = field(default_factory=dict)


def _annualized_sharpe(daily_returns: pd.Series, rf: float = 0.0) -> float:
    r = daily_returns.dropna()
    if len(r) < 10 or r.std() == 0:
        return float("nan")
    mean_ann = r.mean() * 252
    vol_ann = r.std() * math.sqrt(252)
    return float((mean_ann - rf) / vol_ann)


def _trend_strength_r2(prices: pd.Series) -> float:
    s = prices.dropna()
    if len(s) < 30:
        return float("nan")
    y = np.log(s.values)
    x = np.arange(len(y), dtype=float)
    if y.std() == 0:
        return float("nan")
    slope, intercept = np.polyfit(x, y, 1)
    fitted = slope * x + intercept
    ss_res = float(np.sum((y - fitted) ** 2))
    ss_tot = float(np.sum((y - y.mean()) ** 2))
    if ss_tot == 0:
        return float("nan")
    return max(0.0, 1.0 - ss_res / ss_tot)


def compute_features(
    prices: pd.Series,
    volumes_usd: pd.Series | None,
    meta: dict[str, Any],
) -> Features | None:
    if prices is None or len(prices) < MIN_HISTORY_DAYS:
        return None

    f = Features(
        ticker=meta["ticker"],
        asset_class=meta["asset_class"],
        sector=meta.get("sector"),
        name=meta.get("name"),
    )

    # Momentum
    if len(prices) >= 252 + 21:
        last = float(prices.iloc[-21])
        ref = float(prices.iloc[-(252 + 21)])
        if ref > 0:
            f.momentum_12m_minus_1m = last / ref - 1.0
    elif len(prices) >= 90 + 21:
        last = float(prices.iloc[-21])
        ref = float(prices.iloc[0])
        if ref > 0:
            f.momentum_12m_minus_1m = last / ref - 1.0  # approx

    if len(prices) >= 63:
        ref = float(prices.iloc[-63])
        last = float(prices.iloc[-1])
        if ref > 0:
            f.momentum_3m = last / ref - 1.0

    # Returns
    rets = prices.pct_change().dropna()
    if len(rets) >= 60:
        f.realized_vol_90d = float(rets.tail(90).std() * math.sqrt(252))
        f.sharpe_90d = _annualized_sharpe(rets.tail(90))

    # Trend strength
    f.trend_strength_r2 = _trend_strength_r2(prices.tail(180))

    # Volume
    if volumes_usd is not None and len(volumes_usd) >= 90:
        v = volumes_usd.dropna()
        last_30 = v.tail(30).mean()
        prev_60 = v.tail(90).head(60).mean()
        f.volume_usd_30d_avg = float(last_30) if not math.isnan(last_30) else float("nan")
        if prev_60 and prev_60 > 0:
            f.volume_growth_3m = float(last_30 / prev_60 - 1.0)

    return f


