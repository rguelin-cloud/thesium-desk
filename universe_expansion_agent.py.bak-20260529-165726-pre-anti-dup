def insert_candidates(
    conn: sqlite3.Connection,
    features: list[Features],
    scan_batch: str,
) -> int:
    sql = """
        INSERT INTO universe_candidates (
            ticker, name, asset_class, sector, proposed_at, scan_batch, score,
            momentum_12m_minus_1m, momentum_3m, realized_vol_90d, sharpe_90d,
            trend_strength_r2, volume_growth_3m, volume_usd_30d_avg,
            max_correl_existing, max_correl_with, suggested_cap_pct,
            rationale, rationale_source, status
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending');
    """
    n = 0
    ts = datetime.utcnow().isoformat(timespec="seconds")
    for f in features:
        conn.execute(sql, (
            f.ticker, f.name, f.asset_class, f.sector, ts, scan_batch, f.score,
            f.momentum_12m_minus_1m, f.momentum_3m, f.realized_vol_90d, f.sharpe_90d,
            f.trend_strength_r2, f.volume_growth_3m, f.volume_usd_30d_avg,
            f.max_correl_existing, f.max_correl_with, f.suggested_cap_pct,
            f.rationale, f.rationale_source,
        ))
        n += 1
    conn.commit()
    return n


