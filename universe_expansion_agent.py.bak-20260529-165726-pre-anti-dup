# ---------------------------------------------------------------------------
def run_scan(top_n: int = TOP_N, dry_run: bool = False) -> dict[str, Any]:
    """Execute un scan complet. Retourne metadata + nombre de candidats inseres."""
    started = time.time()
    scan_batch = f"scan-{datetime.utcnow().strftime('%Y%m%dT%H%M%S')}-{uuid.uuid4().hex[:6]}"
    log.info("%s scan %s started", MARKER, scan_batch)

    conn = _conn()
    try:
        existing = _existing_instrument_tickers(conn)
        portfolio_returns = _existing_portfolio_returns(conn, window_days=90)
        log.info("Tickers deja en instruments: %d - portfolio returns shape: %s",
                 len(existing), portfolio_returns.shape)

        # ---- Sources ----
        candidates_meta: list[dict[str, Any]] = []

        # Cryptos
        cryptos = fetch_top_cryptos(top=20)
        for c in cryptos:
            if c["ticker"].upper() in existing:
                continue
            if (c.get("total_volume_24h") or 0) * 30 < MIN_VOLUME_USD_30D:
                continue
            candidates_meta.append(c)

        # ETFs SPDR
        for etf in ETF_SPDR_SECTORIELS:
            if etf["ticker"].upper() in existing:
                continue
            candidates_meta.append({
                "id": None,
                "ticker": etf["ticker"],
                "name": etf["name"],
                "asset_class": "etf",
                "sector": etf["sector"],
                "current_price": None,
                "market_cap": None,
                "total_volume_24h": None,
            })

        log.info("Candidats post-filtre-univers : %d", len(candidates_meta))

        # ---- Features ----
        features: list[Features] = []
        for meta in candidates_meta:
            if meta["asset_class"] == "crypto":
                series = fetch_crypto_history(meta["id"], days=365)
                volumes = None  # CoinGecko renvoie aussi volume si demande, simplifie ici
            else:
                series = fetch_etf_history(conn, meta["ticker"], days=365)
                volumes = None
            if series is None or len(series) < MIN_HISTORY_DAYS:
                log.info("Skip %s: history < %dj", meta["ticker"], MIN_HISTORY_DAYS)
                continue
            f = compute_features(series, volumes, meta)
            if f is None:
                continue
            # Correl portefeuille
            mc, with_sym = compute_max_correl(series, portfolio_returns)
            f.max_correl_existing = mc
            f.max_correl_with = with_sym
            features.append(f)

        # Filtre correl
        kept = [
            f for f in features
            if math.isnan(f.max_correl_existing) or abs(f.max_correl_existing) < CORREL_MAX_VS_EXISTING
        ]
        log.info("Apres filtre correlation < %.2f : %d / %d",
                 CORREL_MAX_VS_EXISTING, len(kept), len(features))

        # Scoring + cap
        _normalize_features(kept)
        kept.sort(key=lambda f: -f.score)
        top = kept[:top_n]

        # Rationale
        for f in top:
            f.rationale, f.rationale_source = build_rationale(f)

        inserted = 0
        if top and not dry_run:
            inserted = insert_candidates(conn, top, scan_batch)

        elapsed = time.time() - started
        log.info("%s scan %s done in %.1fs - inserted %d candidats",
                 MARKER, scan_batch, elapsed, inserted)

        return {
            "ok": True,
            "marker": MARKER,
            "scan_batch": scan_batch,
            "elapsed_s": round(elapsed, 2),
            "candidates_universe": len(candidates_meta),
            "after_features": len(features),
            "after_correl_filter": len(kept),
            "inserted": inserted,
            "top_tickers": [f.ticker for f in top],
            "top_scores": [f.score for f in top],
        }
    finally:
        conn.close()


