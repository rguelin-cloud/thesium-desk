# [PPLX_THESIS_AGENT_V3] Challenger Perplexity pour les theses NEXTONES
# - Schema reel : theses(id, instrument_id, agent_type, thesis_text, conviction_score,
#                        horizon, key_drivers, proposed_action, status, created_at, updated_at)
#                 instruments(id, ticker, name, sector, asset_class, created_at)
# - status = 'active' (pas de 'proposed'/'pending')
# - Exclut PortfolioConstructionAgent (rebalancement mecanique, pas de these a challenger)
# - Side derive de proposed_action via regex
# - Stocke dans table thesis_challenge_context
# - Utilise par run_agents_endpoint apres execution (top-N theses)
from __future__ import annotations
import sqlite3
import time
import json
import re
import sys
from pathlib import Path
from pplx_client import pplx_query, MODEL_REASON, MODEL_DEEP

# V3.1 : switch sur sonar-pro (MODEL_DEEP) - sonar-reasoning-pro genere des sorties
# JSON instables (texte apres JSON, arrays mal fermes). sonar-pro plus stable.
_DEFAULT_MODEL = MODEL_DEEP

_DB_PATH = Path(__file__).resolve().parent / "thesium.db"

# Agents dont on challenge les theses (on exclut PortfolioConstructionAgent : pure mecanique)
_CHALLENGEABLE_AGENTS = (
    "FactorAgent",
    "MacroAgent",
    "MicrostructureAgent",
    "AltDataAgent",
    "CryptoAgent",
    "ExitAgent",
)

# Patterns d'actions "no edge" (peu de valeur a challenger une absence de these)
_NO_EDGE_PATTERNS = re.compile(
    r"no\s+(actionable\s+)?(alt-data\s+|factor\s+|microstructure\s+|macro\s+)?edge|"
    r"no\s+new\s+position|"
    r"hold\s+current\s+\w+\s+(allocation|position)s?\s*;\s*no\s+\w+\s+edge|"
    r"monitor\s+for\s+trend|"
    r"hold\s+current\s+allocations?\s*;\s*monitor",
    re.I,
)

# ---------------------------------------------------------------------------
# Side derivation
# ---------------------------------------------------------------------------
_SIDE_PATTERNS = [
    (re.compile(r"\b(BUY|LONG|INCREASE|ACCUMULATE|ADD|OVERWEIGHT)\b", re.I), "LONG"),
    (re.compile(r"\b(SELL|SHORT|REDUCE|TRIM|UNDERWEIGHT|EXIT|CLOSE)\b", re.I), "SHORT"),
    (re.compile(r"\b(HOLD|MAINTAIN|MONITOR|NEUTRAL|NO\s+EDGE|NO\s+NEW)\b", re.I), "HOLD"),
]

def _derive_side(proposed_action: str | None) -> str:
    if not proposed_action:
        return "HOLD"
    for pat, side in _SIDE_PATTERNS:
        if pat.search(proposed_action):
            return side
    return "HOLD"


def _is_no_edge(proposed_action: str | None) -> bool:
    """Detecte les theses sans edge actionable (peu utile a challenger)."""
    if not proposed_action:
        return True
    return bool(_NO_EDGE_PATTERNS.search(proposed_action))


def _action_priority(thesis: dict) -> int:
    """Score de priorite pour le tri (plus haut = challenge plus interessant).
    LONG/SHORT explicite = 100, HOLD substantiel (Accumulate/Reduce/Trim) = 50,
    HOLD generique = 10, no edge = 0.
    """
    side = thesis.get("side", "HOLD")
    action = (thesis.get("proposed_action") or "").lower()
    if _is_no_edge(action):
        return 0
    if side in ("LONG", "SHORT"):
        return 100
    # HOLD mais avec verbe actionable (accumulate, trim, reduce, hedge...)
    if re.search(r"accumul|trim|reduce|hedge|stop[-\s]?loss|target\s+\$|breakout|pullback", action):
        return 50
    return 10


