<!-- ===== PANEL PORTFOLIO IDÉAL VS ACTUEL ===== -->
<div class="panel" id="panel-construction">

  <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-bottom:12px;">
    <h2 class="panel-title" style="margin:0;">Portfolio idéal vs actuel</h2>
    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
      <span id="construction-updated-at" class="loading-msg"></span>
      <button class="btn" id="btn-recalculate" onclick="runConstruction()" title="Relance le PortfolioConstructionAgent Jalon 2">
        Recalculer cibles
      </button>
    </div>
  </div>

  <!-- Barre de statut NAV -->
  <div id="construction-nav-bar" style="font-size:0.85rem; color:#6b7280; margin-bottom:10px;"></div>

  <!-- Message d'état (chargement / erreur) -->
  <p id="construction-status" class="loading-msg">Chargement...</p>

  <!-- Tableau principal -->
  <div id="construction-table-wrap" style="display:none;">
    <table class="data-table" id="construction-table" style="width:100%; border-collapse:collapse;">
      <thead>
        <tr>
          <th style="text-align:left;">Ticker</th>
          <th style="text-align:right;">Poids actuel</th>
          <th style="text-align:right;">Poids cible</th>
          <th style="text-align:right;">Delta</th>
          <th style="text-align:center;">Action</th>
          <th style="text-align:center;">Signal</th>
          <th style="text-align:right;">Score</th>
          <th style="text-align:left;">Source</th>
        </tr>
      </thead>
      <tbody id="construction-tbody">
        <!-- Lignes injectées par JS -->
      </tbody>
      <tfoot id="construction-tfoot">
        <!-- Ligne cash injectée par JS -->
      </tfoot>
    </table>
  </div>

</div>
